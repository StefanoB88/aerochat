    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat bruger Bluetooth til at udveksle krypterede beskeder med rejsemakkere i nærheden, også uden Wi-Fi eller mobilnetværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat nutzt Bluetooth, um verschlüsselte Nachrichten mit Reisebuddys in der Nähe auszutauschen – auch ohne WLAN oder Mobilfunk."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat uses Bluetooth to exchange encrypted messages with nearby travel buddies, even without Wi-Fi or cellular service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat usa el Bluetooth para intercambiar mensajes cifrados con los compañeros de viaje cercanos, incluso sin Wi‑Fi ni red móvil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat utilise le Bluetooth pour échanger des messages chiffrés avec les compagnons de voyage à proximité, même sans Wi-Fi ni réseau cellulaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AeroChat usa il Bluetooth per scambiare messaggi cifrati con i compagni di volo vicini, anche senza Wi-Fi o rete cellulare."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat bruker Bluetooth til å utveksle krypterte meldinger med reisekamerater i nærheten, også uten Wi-Fi eller mobilnett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat gebruikt Bluetooth om versleutelde berichten uit te wisselen met reisgenoten in de buurt, ook zonder wifi of mobiel netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat używa Bluetooth do wymiany zaszyfrowanych wiadomości z towarzyszami podróży w pobliżu, nawet bez Wi‑Fi i sieci komórkowej."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A AeroChat usa o Bluetooth para trocar mensagens cifradas com os companheiros de viagem por perto, mesmo sem Wi‑Fi nem rede móvel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat använder Bluetooth för att utbyta krypterade meddelanden med resekompisar i närheten, även utan Wi-Fi eller mobilnät."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat bruger kameraet til at scanne dine rejsemakkeres QR-koder og til at tage fotos, du vil sende."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat nutzt die Kamera, um die QR-Codes deiner Reisebuddys zu scannen und Fotos zum Senden aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat uses the camera to scan your travel buddies’ QR codes and to take photos to send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat usa la cámara para escanear el código QR de tus compañeros de viaje y para hacer las fotos que quieras enviar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat utilise l’appareil photo pour scanner le QR code de tes compagnons de voyage et prendre les photos à envoyer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AeroChat usa la fotocamera per inquadrare il QR Code dei compagni di volo e per scattare le foto da inviare."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat bruker kameraet til å skanne QR-kodene til reisekameratene og til å ta bilder du vil sende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat gebruikt de camera om de QR-code van je reisgenoten te scannen en om foto’s te maken die je wilt versturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat używa aparatu do skanowania kodów QR towarzyszy podróży i robienia zdjęć do wysłania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A AeroChat usa a câmara para digitalizar o código QR dos teus companheiros de viagem e para tirar as fotos que queres enviar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat använder kameran för att skanna dina resekompisars QR-koder och för att ta foton att skicka."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat bruger kun din placering, når du beder om det: for at dele den i en chat eller vedhæfte den til en nødbesked til telefoner i nærheden. Den sendes aldrig til en server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat verwendet deinen Standort nur, wenn du es möchtest: um ihn in einem Chat zu teilen oder an eine Notfallnachricht an Telefone in der Nähe anzuhängen. Er wird nie an einen Server gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat uses your location only when you ask: to share it in a chat or attach it to an emergency message for nearby phones. It is never sent to a server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat usa tu ubicación solo cuando tú lo pides: para compartirla en un chat o adjuntarla a un mensaje de emergencia a los teléfonos cercanos. Nunca se envía a un servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat utilise ta position uniquement quand tu le demandes : pour la partager dans une discussion ou la joindre à un message d'urgence aux téléphones proches. Elle n'est jamais envoyée à un serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AeroChat usa la posizione solo quando lo chiedi tu: per condividerla in una chat o allegarla a un messaggio di emergenza ai telefoni vicini. Non viene mai inviata a server."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat bruker posisjonen din bare når du ber om det: for å dele den i en chat eller legge den ved en nødmelding til telefoner i nærheten. Den sendes aldri til en server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat gebruikt je locatie alleen als jij daarom vraagt: om hem in een chat te delen of aan een noodbericht voor telefoons in de buurt toe te voegen. Hij wordt nooit naar een server gestuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat używa Twojej lokalizacji tylko na Twoją prośbę: aby udostępnić ją w czacie lub dołączyć do wiadomości alarmowej dla pobliskich telefonów. Nigdy nie jest wysyłana na serwer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AeroChat usa a tua localização apenas quando o pedes: para a partilhar numa conversa ou anexá-la a uma mensagem de emergência para os telemóveis próximos. Nunca é enviada para um servidor."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat använder din plats bara när du ber om det: för att dela den i en chatt eller bifoga den till ett nödmeddelande till telefoner i närheten. Den skickas aldrig till en server."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat bruger mikrofonen til at optage talebeskeder, som du sender til dine rejsemakkere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat nutzt das Mikrofon, um Sprachnotizen für deine Reisebuddys aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat uses the microphone to record voice notes to send to your travel buddies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat usa el micrófono para grabar las notas de voz que envías a tus compañeros de viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat utilise le micro pour enregistrer les notes vocales à envoyer à tes compagnons de voyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AeroChat usa il microfono per registrare le note vocali da inviare ai compagni di volo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat bruker mikrofonen til å ta opp talemeldinger som du sender til reisekameratene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat gebruikt de microfoon om spraakberichten op te nemen die je naar je reisgenoten stuurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat używa mikrofonu do nagrywania wiadomości głosowych wysyłanych do towarzyszy podróży."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A AeroChat usa o microfone para gravar as notas de voz que envias aos teus companheiros de viagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat använder mikrofonen för att spela in röstmeddelanden som du skickar till dina resekompisar."
          }
        }
      }
    },
    "NSNearbyInteractionUsageDescription" : {
      "comment" : "Privacy - Nearby Interaction Usage Description",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat bruger UWB-chippen til at måle afstand og retning til iPhones i nærheden, der har radaren åben, så du kan finde dine rejsekammerater."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat misst mit dem UWB-Chip Entfernung und Richtung von iPhones in der Nähe, die das Radar geöffnet haben, damit du deine Mitreisenden findest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat uses the UWB chip to measure the distance and direction of nearby iPhones that have the radar open, to help you find your travel companions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat usa el chip UWB para medir la distancia y la dirección de los iPhone cercanos con el radar abierto, para ayudarte a encontrar a tus compañeros de viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat utilise la puce UWB pour mesurer la distance et la direction des iPhone proches dont le radar est ouvert, afin de vous aider à retrouver vos compagnons de voyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat misura con il chip UWB la distanza e la direzione degli iPhone vicini che hanno il radar aperto, per aiutarti a ritrovare i tuoi compagni di viaggio."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat bruker UWB-brikken til å måle avstand og retning til iPhoner i nærheten som har radaren åpen, så du finner reisefølget ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat meet met de UWB-chip de afstand en richting van iPhones in de buurt die de radar open hebben, zodat je je reisgenoten terugvindt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat mierzy chipem UWB odległość i kierunek pobliskich iPhone’ów z otwartym radarem, aby pomóc Ci odnaleźć towarzyszy podróży."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AeroChat usa o chip UWB para medir a distância e a direção dos iPhones próximos com o radar aberto, para ajudar a encontrar os seus companheiros de viagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AeroChat använder UWB-chippet för att mäta avstånd och riktning till iPhones i närheten som har radarn öppen, så att du hittar dina reskamrater."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat gemmer fotos, du har modtaget i chatten, i dit bibliotek, når du beder om det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat sichert in Chats empfangene Fotos in deiner Mediathek, wenn du es möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat saves photos you received in chat to your library when you ask it to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat guarda en tu fototeca las fotos recibidas en el chat cuando tú lo pides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat enregistre dans ta photothèque les photos reçues dans le chat lorsque tu le demandes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AeroChat salva nel rullino le foto ricevute in chat quando lo chiedi tu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat lagrer bilder du har mottatt i chatten, i biblioteket ditt når du ber om det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat bewaart in de chat ontvangen foto's in je fotobibliotheek wanneer je daarom vraagt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat zapisuje w bibliotece zdjęcia otrzymane na czacie, gdy o to poprosisz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O AeroChat guarda na tua fototeca as fotos recebidas no chat quando o pedes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat sparar foton du tagit emot i chatten i ditt bibliotek när du ber om det."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat får adgang til de fotos, du vælger at dele med dine rejsemakkere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat greift auf die Fotos zu, die du mit deinen Reisebuddys teilen möchtest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat accesses the photos you choose to share with your travel buddies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat accede a las fotos que eliges compartir con tus compañeros de viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat accède aux photos que tu choisis de partager avec tes compagnons de voyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AeroChat accede alle foto che scegli di condividere con i compagni di volo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat får tilgang til bildene du velger å dele med reisekameratene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat heeft toegang tot de foto’s die je met je reisgenoten wilt delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat uzyskuje dostęp do zdjęć, które wybierzesz do udostępnienia towarzyszom podróży."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A AeroChat acede às fotos que escolhes partilhar com os teus companheiros de viagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "AeroChat får tillgång till de foton du väljer att dela med dina resekompisar."
          }
        }
      }
    }
  },
  "version" : "1.3"
}