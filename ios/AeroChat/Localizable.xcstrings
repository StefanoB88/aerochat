    "Ciao! Sono il compagno di volo simulato: rispondo dallo stesso iPhone, senza Bluetooth. 👋" : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hej! Jeg er den simulerede rejsekammerat: jeg svarer fra den samme iPhone, uden Bluetooth. 👋"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hallo! Ich bin der simulierte Mitreisende: Ich antworte vom selben iPhone aus, ganz ohne Bluetooth. 👋"
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Hi! I’m the simulated travel buddy: I reply from this same iPad, no Bluetooth needed. 👋"
                }
              },
              "iphone" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Hi! I’m the simulated travel buddy: I reply from this same iPhone, no Bluetooth needed. 👋"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "Hi! I’m the simulated travel buddy: I reply from this same device, no Bluetooth needed. 👋"
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¡Hola! Soy el compañero de viaje simulado: respondo desde este mismo iPhone, sin Bluetooth. 👋"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Salut ! Je suis le compagnon de voyage simulé : je réponds depuis ce même iPhone, sans Bluetooth. 👋"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hei! Jeg er den simulerte reisekameraten: jeg svarer fra den samme iPhonen, uten Bluetooth. 👋"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hoi! Ik ben de gesimuleerde reisgenoot: ik antwoord vanaf dezelfde iPhone, zonder Bluetooth. 👋"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Cześć! Jestem symulowanym towarzyszem podróży: odpowiadam z tego samego iPhone’a, bez Bluetooth. 👋"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Olá! Sou o companheiro de viagem simulado: respondo a partir do mesmo iPhone, sem Bluetooth. 👋"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hej! Jag är den simulerade resekamraten: jag svarar från samma iPhone, utan Bluetooth. 👋"
          }
        }
      }
    },
