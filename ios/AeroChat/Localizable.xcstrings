        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wygenerowane w całości na urządzeniu z Apple Intelligence: żadna wiadomość nie opuszcza telefonu. Może zawierać nieścisłości."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gerado inteiramente no dispositivo com Apple Intelligence: nenhuma mensagem sai do telemóvel. Pode conter imprecisões."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skapat helt på enheten med Apple Intelligence: inget meddelande lämnar telefonen. Kan innehålla felaktigheter."
          }
        }
      }
    },
