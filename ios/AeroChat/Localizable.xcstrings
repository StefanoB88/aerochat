            "value" : "Señal débil: acercaos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signal faible : rapprochez-vous"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Svakt signal: gå nærmere hverandre"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zwak signaal: ga dichter bij elkaar"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Słaby sygnał: zbliżcie się"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sinal fraco: aproximem-se"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Svag signal: gå närmare varandra"
          }
        }
      }
    },
    "Segnale troppo debole per una chiamata: avvicinatevi di qualche fila." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signalet er for svagt til et opkald: ryk et par rækker tættere på hinanden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signal zu schwach für einen Anruf: Rückt ein paar Reihen näher zusammen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signal too weak for a call: move a few rows closer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Señal demasiado débil para una llamada: acercaos unas filas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signal trop faible pour un appel : rapprochez-vous de quelques rangées."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signalet er for svakt til et anrop: flytt dere noen rader nærmere hverandre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signaal te zwak voor een oproep: ga een paar rijen dichter bij elkaar zitten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sygnał zbyt słaby na połączenie: zbliżcie się o kilka rzędów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sinal demasiado fraco para uma chamada: aproximem-se algumas filas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Signalen är för svag för ett samtal: flytta er några rader närmare varandra."
          }
        }
      }
    },
    "Sei a bordo di %@! Chi scansiona la stessa carta ti trova qui." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du er om bord på %@! Alle, der scanner det samme boardingkort, finder dig her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du bist an Bord von %@! Wer dieselbe Bordkarte scannt, findet dich hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "You’re on board %@! Anyone who scans the same boarding pass finds you here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¡Estás a bordo del %@! Quien escanee la misma tarjeta te encontrará aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu es à bord du vol %@ ! Ceux qui scannent la même carte te retrouvent ici."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du er om bord på %@! Alle som skanner det samme boardingkortet, finner deg her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je bent aan boord van %@! Wie dezelfde instapkaart scant, vindt je hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jesteś na pokładzie %@! Każdy, kto zeskanuje tę samą kartę, znajdzie Cię tutaj."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Estás a bordo do %@! Quem digitalizar o mesmo cartão encontra-te aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du är ombord på %@! Alla som skannar samma boardingkort hittar dig här."
          }
        }
      }
    },
