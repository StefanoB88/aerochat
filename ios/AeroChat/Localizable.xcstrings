    "Nessun vicino del tuo volo ha condiviso il posto, per ora. Condividi il tuo per comparire sulla mappa." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen på dit fly har delt deres sæde endnu. Del dit for at komme med på kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch hat niemand von deinem Flug seinen Platz geteilt. Teile deinen, um auf dem Plan zu erscheinen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody on your flight has shared their seat yet. Share yours to appear on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie de tu vuelo ha compartido su asiento todavía. Comparte el tuyo para aparecer en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne de ton vol n'a encore partagé son siège. Partage le tien pour apparaître sur le plan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen på flyet ditt har delt setet sitt ennå. Del ditt for å vises på kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niemand van je vlucht heeft zijn stoel gedeeld. Deel de jouwe om op de kaart te verschijnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt z Twojego lotu nie udostępnił jeszcze miejsca. Udostępnij swoje, aby pojawić się na mapie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda ninguém do teu voo partilhou o lugar. Partilha o teu para apareceres no mapa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen på ditt flyg har delat sin plats ännu. Dela din för att synas på kartan."
          }
        }
      }
    },
