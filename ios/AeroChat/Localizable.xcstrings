    "Segnale debole: avvicinatevi" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Svagt signal: ryk tættere sammen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Schwaches Signal: Kommt näher zusammen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Weak signal: move closer"
          }
        },
        "es" : {
