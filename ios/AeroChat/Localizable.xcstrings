    "%@ riceverà la sfida: se accetta, la partita parte subito." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will get your challenge: if they accept, the game starts right away."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erhält deine Herausforderung: Nimmt er sie an, startet das Spiel sofort."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va recevoir ton défi : s'il accepte, la partie commence aussitôt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recibirá el reto: si acepta, la partida empieza enseguida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vai receber o desafio: se aceitar, o jogo começa logo."
