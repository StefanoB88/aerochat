    },
    "Tieni premuto un messaggio ricevuto e scegli «Traduci». Per usarlo senza internet scarica prima le lingue nell'app Traduci di Apple, finché c'è rete." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på en modtaget besked, og vælg “Oversæt”. For at bruge det uden internet skal du først hente sprogene i Apples app Oversæt, mens du har forbindelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine empfangene Nachricht gedrückt und wähle „Übersetzen“. Um ohne Internet zu übersetzen, lade die Sprachen vorher in Apples Übersetzen-App, solange du Netz hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold a received message and choose “Translate”. To use it without internet, first download the languages in Apple's Translate app while you still have a connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un mensaje recibido y elige «Traducir». Para usarlo sin internet, descarga antes los idiomas en la app Traducir de Apple mientras tengas conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintiens le doigt sur un message reçu et choisis « Traduire ». Pour l'utiliser sans Internet, télécharge d'abord les langues dans l'app Traduire d'Apple tant que tu as du réseau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne på en mottatt melding og velg «Oversett». For å bruke det uten internett må du først laste ned språkene i Apples Oversett-app mens du har nett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een ontvangen bericht ingedrukt en kies ‘Vertaal’. Om het zonder internet te gebruiken, download je eerst de talen in de Vertaal-app van Apple zolang je nog verbinding hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj otrzymaną wiadomość i wybierz „Przetłumacz”. Aby korzystać bez internetu, najpierw pobierz języki w aplikacji Tłumacz od Apple, póki masz zasięg."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém premida uma mensagem recebida e escolhe «Traduzir». Para usar sem internet, descarrega primeiro os idiomas na app Traduzir da Apple enquanto tens rede."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned på ett mottaget meddelande och välj ”Översätt”. För att använda det utan internet laddar du först ned språken i Apples app Översätt medan du har nät."
          }
        }
      }
    },
