    "Inquadra il codice a barre della carta d'imbarco (anche dallo schermo di un altro telefono o dal Wallet). Leggiamo solo compagnia, numero di volo e data: nome e PNR vengono ignorati." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scan stregkoden på dit boardingkort (også fra en anden telefons skærm eller fra Wallet). Vi læser kun flyselskab, flynummer og dato: navn og PNR ignoreres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scanne den Barcode deiner Bordkarte (auch vom Bildschirm eines anderen Telefons oder aus Wallet). Wir lesen nur Fluggesellschaft, Flugnummer und Datum: Name und PNR werden ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scan the barcode on your boarding pass (even from another phone’s screen or from Wallet). Only the airline, flight number, and date are read: your name and PNR are ignored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escanea el código de barras de la tarjeta de embarque (también desde la pantalla de otro teléfono o desde Wallet). Solo leemos la aerolínea, el número de vuelo y la fecha: el nombre y el PNR se ignoran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scanne le code-barres de ta carte d’embarquement (même depuis l’écran d’un autre téléphone ou depuis Wallet). Nous ne lisons que la compagnie, le numéro de vol et la date : le nom et le PNR sont ignorés."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skann strekkoden på boardingkortet (også fra skjermen på en annen telefon eller fra Wallet). Vi leser bare flyselskap, flightnummer og dato: navn og PNR ignoreres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scan de streepjescode op je instapkaart (ook vanaf het scherm van een andere telefoon of uit Wallet). We lezen alleen de maatschappij, het vluchtnummer en de datum: naam en PNR worden genegeerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeskanuj kod kreskowy z karty pokładowej (także z ekranu innego telefonu lub z Wallet). Odczytujemy tylko linię lotniczą, numer lotu i datę: imię, nazwisko i PNR są pomijane."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digitaliza o código de barras do cartão de embarque (mesmo a partir do ecrã de outro telemóvel ou do Wallet). Lemos apenas a companhia, o número do voo e a data: o nome e o PNR são ignorados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skanna streckkoden på boardingkortet (även från en annan telefons skärm eller från Wallet). Vi läser bara flygbolag, flightnummer och datum: namn och PNR ignoreras."
          }
        }
      }
    },
    "Inquadra la carta d'imbarco per entrare nella chat del tuo volo, o aggiungi i compagni al gate: a bordo vi troverete da soli via Bluetooth." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scan dit boardingkort for at komme ind i chatten for dit fly, eller tilføj dine rejsekammerater ved gaten: om bord finder I hinanden helt af jer selv via Bluetooth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scanne deine Bordkarte, um dem Chat deines Flugs beizutreten, oder füge deine Mitreisenden am Gate hinzu: An Bord findet ihr euch dann von selbst über Bluetooth."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scan your boarding pass to join your flight’s chat, or add your travel buddies at the gate: once on board, you’ll find each other over Bluetooth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Escanea la tarjeta de embarque para entrar en el chat de tu vuelo, o añade a tus compañeros en la puerta de embarque: a bordo os encontraréis solos por Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scanne ta carte d’embarquement pour rejoindre la discussion de ton vol, ou ajoute tes compagnons de voyage à la porte d’embarquement : à bord, vous vous retrouverez tout seuls via Bluetooth."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skann boardingkortet for å bli med i chatten for flyvningen din, eller legg til reisekameratene ved gaten: om bord finner dere hverandre selv via Bluetooth."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Scan je instapkaart om de chat van je vlucht binnen te gaan, of voeg je reisgenoten toe bij de gate: aan boord vinden jullie elkaar vanzelf via Bluetooth."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zeskanuj kartę pokładową, aby wejść do czatu swojego lotu, albo dodaj towarzyszy podróży przy bramce: na pokładzie odnajdziecie się sami przez Bluetooth."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Digitaliza o cartão de embarque para entrares na conversa do teu voo, ou adiciona os companheiros na porta de embarque: a bordo, vão encontrar-se sozinhos por Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Skanna boardingkortet för att gå med i chatten för din flygresa, eller lägg till resekamrater vid gaten: ombord hittar ni varandra av er själva via Bluetooth."
          }
        }
      }
    },
