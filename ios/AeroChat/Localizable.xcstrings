    "Tieni premuto un messaggio per bloccare o segnalare chi lo ha scritto." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hold en besked nede for at blokere eller anmelde den, der har skrevet den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Halte eine Nachricht gedrückt, um den Verfasser zu blockieren oder zu melden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Touch and hold a message to block or report the person who wrote it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantén pulsado un mensaje para bloquear o denunciar a quien lo ha escrito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Maintiens le doigt sur un message pour bloquer ou signaler son auteur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hold inne en melding for å blokkere eller rapportere den som skrev den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Houd een bericht ingedrukt om de schrijver ervan te blokkeren of te melden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Przytrzymaj wiadomość, aby zablokować lub zgłosić jej autora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mantém premida uma mensagem para bloquear ou denunciar quem a escreveu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Håll fingret på ett meddelande för att blockera eller rapportera den som skrev det."
          }
        }
      }
    },
