    "Serve per misurare con precisione distanza e direzione degli iPhone vicini sul radar. Consentila ad AeroChat nelle Impostazioni." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til præcist at måle afstand og retning til iPhones i nærheden på radaren. Tillad det for AeroChat i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden Entfernung und Richtung von iPhones in der Nähe auf dem Radar genau gemessen. Erlaube es AeroChat in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s used to precisely measure the distance and direction of nearby iPhones on the radar. Allow it for AeroChat in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sirve para medir con precisión la distancia y la dirección de los iPhone cercanos en el radar. Permítesela a AeroChat en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle sert à mesurer précisément la distance et la direction des iPhone proches sur le radar. Autorisez-la pour AeroChat dans Réglages."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til å måle avstand og retning til iPhoner i nærheten nøyaktig på radaren. Tillat det for AeroChat i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden afstand en richting van iPhones in de buurt nauwkeurig op de radar gemeten. Sta het toe voor AeroChat in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do precyzyjnego pomiaru odległości i kierunku pobliskich iPhone’ów na radarze. Zezwól na to AeroChat w Ustawieniach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serve para medir com precisão a distância e a direção dos iPhones próximos no radar. Permita-a ao AeroChat nas Definições."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att exakt mäta avstånd och riktning till iPhones i närheten på radarn. Tillåt det för AeroChat i Inställningar."
          }
        }
      }
    },
