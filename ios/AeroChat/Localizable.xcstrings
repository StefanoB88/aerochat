    "Entra nel mio gruppo AeroChat “%@”: chat via Bluetooth, anche in aereo senza Wi-Fi." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kom med i min AeroChat-gruppe „%@“: chat via Bluetooth, selv i flyet uden Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
