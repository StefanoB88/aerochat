    "Generato interamente sul dispositivo con Apple Intelligence: nessun messaggio lascia il telefono. Può contenere imprecisioni." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Genereret udelukkende på enheden med Apple Intelligence: ingen beskeder forlader telefonen. Kan indeholde unøjagtigheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vollständig auf dem Gerät mit Apple Intelligence erstellt: Keine Nachricht verlässt dein Telefon. Kann Ungenauigkeiten enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Generated entirely on device with Apple Intelligence: no message leaves your phone. May contain inaccuracies."
