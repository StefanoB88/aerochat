    "Vedi solo chi è a portata di Bluetooth e ha AeroChat aperta. Nessuno diventa tuo contatto finché non accetta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You only see people within Bluetooth range with AeroChat open. Nobody becomes a contact until they accept."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siehst nur Leute in Bluetooth-Reichweite mit geöffnetem AeroChat. Niemand wird Kontakt, bevor er annimmt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne vois que les personnes à portée Bluetooth avec AeroChat ouverte. Personne ne devient ton contact sans accepter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ves a quien está al alcance del Bluetooth con AeroChat abierta. Nadie se convierte en contacto hasta que acepta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só vês quem está ao alcance do Bluetooth com o AeroChat aberto. Ninguém se torna contacto até aceitar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ziet alleen mensen binnen Bluetooth-bereik met AeroChat open. Niemand wordt een contact tot die accepteert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widzisz tylko osoby w zasięgu Bluetooth z otwartym AeroChat. Nikt nie zostaje kontaktem, dopóki nie zaakceptuje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser bara folk inom Bluetooth-räckvidd med AeroChat öppen. Ingen blir kontakt förrän hen accepterar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser kun folk inden for Bluetooth-rækkevidde med AeroChat åben. Ingen bliver kontakt, før de accepterer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du ser bare folk innen Bluetooth-rekkevidde med AeroChat åpen. Ingen blir kontakt før de godtar."
          }
        }
      }
    },
