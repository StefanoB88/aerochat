    "Fila 12 qui: si vede un tramonto pazzesco dal finestrino." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Række 12 her: der er en vild solnedgang uden for vinduet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reihe 12 hier: Aus dem Fenster sieht man einen irren Sonnenuntergang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Row 12 here: there’s an amazing sunset out the window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aquí fila 12: se ve un atardecer increíble por la ventanilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rangée 12 ici : le coucher de soleil par le hublot est dingue."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rad 12 her: det er en helt vill solnedgang utenfor vinduet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rij 12 hier: wat een waanzinnige zonsondergang door het raampje."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu rząd 12: za oknem widać niesamowity zachód słońca."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fila 12 aqui: vê-se um pôr do sol incrível pela janela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rad 12 här: det är en helt galen solnedgång utanför fönstret."
          }
        }
      }
    },
    "Fila e lettera, come sulla carta d'imbarco (es. 14C). Lascia vuoto per cancellarlo." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Række og bogstav som på boardingkortet (f.eks. 14C). Lad feltet være tomt for at slette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reihe und Buchstabe wie auf der Bordkarte (z. B. 14C). Leer lassen zum Löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Row and letter, as on your boarding pass (e.g. 14C). Leave empty to clear it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila y letra, como en la tarjeta de embarque (p. ej. 14C). Déjalo vacío para borrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangée et lettre, comme sur la carte d'embarquement (ex. 14C). Laisse vide pour l'effacer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rad og bokstav, som på boardingkortet (f.eks. 14C). La feltet stå tomt for å slette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rij en letter, zoals op je instapkaart (bijv. 14C). Laat leeg om te wissen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rząd i litera, jak na karcie pokładowej (np. 14C). Zostaw puste, aby usunąć."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila e letra, como no cartão de embarque (ex.: 14C). Deixa vazio para apagar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rad och bokstav, som på boardingkortet (t.ex. 14C). Lämna tomt för att radera."
          }
        }
      }
    },
