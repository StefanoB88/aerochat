    "La Cabina si svuota ogni 12 ore e resta solo sui telefoni a bordo." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kabinen tømmes hver 12. time og findes kun på telefonerne om bord."
          }
        },
        "de" : {
