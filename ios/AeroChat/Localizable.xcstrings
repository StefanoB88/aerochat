    "Basta un Pass nel gruppo: chi lo possiede lo condivide con tutti i membri, anche Android e con app gratuita." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ét Pass i gruppen er nok: den, der har det, deler det med alle medlemmer, også Android-brugere med gratisappen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Pass in der Gruppe genügt: Wer ihn besitzt, teilt ihn mit allen Mitgliedern – auch mit Android-Nutzern und der Gratis-App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "One Pass in the group is enough: whoever has it shares it with every member, including Android users on the free app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Basta con un Pass en el grupo: quien lo tiene lo comparte con todos los miembros, también en Android y con la app gratuita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un seul Pass suffit dans le groupe : celui qui le possède le partage avec tous les membres, même sur Android et avec l’app gratuite."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ett Pass i gruppen er nok: den som har det, deler det med alle medlemmene, også Android-brukere med gratisappen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eén Pass in de groep is genoeg: wie hem heeft, deelt hem met alle leden, ook Android-gebruikers met de gratis app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wystarczy jeden Pass w grupie: jego właściciel udostępnia go wszystkim członkom, także użytkownikom Androida i darmowej aplikacji."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Basta um Pass no grupo: quem o tiver partilha-o com todos os membros, mesmo com Android e com a app gratuita."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Det räcker med ett Pass i gruppen: den som har det delar det med alla medlemmar, även Android-användare med gratisappen."
          }
        }
      }
    },
