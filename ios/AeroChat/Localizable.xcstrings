    "Acquisti una tantum addebitati sul tuo account App Store. Nessun rinnovo automatico." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Engangskøb, der trækkes på din App Store-konto. Ingen automatisk fornyelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Einmalige Käufe, die über dein App Store-Konto abgerechnet werden. Keine automatische Verlängerung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "One-time purchases charged to your App Store account. No automatic renewal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Compras únicas que se cargan a tu cuenta del App Store. Sin renovación automática."
