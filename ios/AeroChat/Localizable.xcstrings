    "Pass inviato ai membri a portata; gli altri lo ricevono appena si collegano." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Passet er sendt til medlemmerne inden for rækkevidde; de øvrige modtager det, så snart de forbinder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pass an die Mitglieder in Reichweite gesendet; die anderen erhalten ihn, sobald sie sich verbinden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pass sent to the members in range; the others get it as soon as they connect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pass enviado a los miembros al alcance; los demás lo recibirán en cuanto se conecten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pass envoyé aux membres à portée ; les autres le reçoivent dès qu’ils se connectent."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Passet er sendt til medlemmene innen rekkevidde; de andre får det så snart de kobler seg til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pass verzonden naar de leden binnen bereik; de anderen ontvangen hem zodra ze verbinding maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pass wysłany do członków w zasięgu; pozostali otrzymają go, gdy tylko się połączą."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pass enviado aos membros ao alcance; os outros recebem-no assim que se ligarem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Passet har skickats till medlemmarna inom räckhåll; de andra får det så fort de ansluter."
          }
        }
      }
    },
