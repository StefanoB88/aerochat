    "Andata, soggiorno e ritorno. Sblocca il tuo gruppo di viaggio: 1 paga, tutti usano." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Udrejse, ophold og hjemrejse. Lås din rejsegruppe op: Én betaler, alle bruger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hinflug, Aufenthalt und Rückflug. Schalte deine Reisegruppe frei: Einer zahlt, alle nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "There, your stay, and back. Unlock your travel group: one pays, everyone uses it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ida, estancia y vuelta. Desbloquea tu grupo de viaje: uno paga, todos lo usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aller, séjour et retour. Débloque ton groupe de voyage : 1 paie, tout le monde en profite."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utreise, opphold og hjemreise. Lås opp reisegruppen din: én betaler, alle bruker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Heen, verblijf en terug. Ontgrendel je reisgroep: 1 betaalt, iedereen gebruikt het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tam, pobyt i z powrotem. Odblokuj swoją grupę podróży: 1 płaci, wszyscy korzystają."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ida, estadia e regresso. Desbloqueia o teu grupo de viagem: 1 paga, todos usam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dit, vistelse och hem igen. Lås upp din resegrupp: en betalar, alla använder."
          }
        }
      }
    },
