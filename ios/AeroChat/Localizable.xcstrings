    "Generato interamente sul dispositivo con Apple Intelligence: nessun messaggio lascia il telefono. Può contenere imprecisioni." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Genereret udelukkende på enheden med Apple Intelligence: ingen beskeder forlader telefonen. Kan indeholde unøjagtigheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vollständig auf dem Gerät mit Apple Intelligence erstellt: Keine Nachricht verlässt dein Telefon. Kann Ungenauigkeiten enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Generated entirely on device with Apple Intelligence: no message leaves your phone. May contain inaccuracies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Generado íntegramente en el dispositivo con Apple Intelligence: ningún mensaje sale del teléfono. Puede contener imprecisiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Généré entièrement sur l’appareil avec Apple Intelligence : aucun message ne quitte le téléphone. Peut contenir des inexactitudes."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Generert fullstendig på enheten med Apple Intelligence: ingen meldinger forlater telefonen. Kan inneholde unøyaktigheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Volledig op het apparaat gegenereerd met Apple Intelligence: geen enkel bericht verlaat je telefoon. Kan onnauwkeurigheden bevatten."
          }
