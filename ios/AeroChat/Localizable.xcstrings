    "Con un secondo telefono i messaggi passerebbero via mesh BLE, cifrati end-to-end." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med endnu en telefon ville beskederne gå via BLE-mesh, end-to-end-krypteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mit einem zweiten Telefon würden die Nachrichten über das BLE-Mesh laufen, Ende-zu-Ende-verschlüsselt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "With a second phone, messages would travel over the BLE mesh, encrypted end-to-end."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Con un segundo teléfono, los mensajes viajarían por la malla BLE, cifrados de extremo a extremo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Avec un second téléphone, les messages passeraient par le réseau mesh BLE, chiffrés de bout en bout."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med en telefon til ville meldingene gått via BLE-mesh, ende-til-ende-kryptert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Met een tweede telefoon zouden de berichten via het BLE-meshnetwerk gaan, end-to-end versleuteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Z drugim telefonem wiadomości szłyby przez sieć mesh BLE, szyfrowane end-to-end."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Com um segundo telemóvel, as mensagens passariam pela rede mesh BLE, cifradas de ponta a ponta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Med en andra telefon skulle meddelandena gå via BLE-meshnätet, totalsträckskrypterade."
          }
        }
      }
    },
