    "Senza il permesso Bluetooth AeroChat non può vedere nessuno." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden Bluetooth-tilladelse kan AeroChat ikke se nogen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Bluetooth-Berechtigung kann AeroChat niemanden sehen."
          }
        },
