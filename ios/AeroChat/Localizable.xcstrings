    "Nessun annuncio per ora. Cerchi un caricatore o vuoi offrire uno snack? Scrivilo qui: lo vede chi è vicino." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen opslag endnu. Leder du efter en oplader, eller vil du dele en snack? Skriv det her: dem i nærheden kan se det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Anzeigen. Suchst du ein Ladekabel oder möchtest du einen Snack teilen? Schreib es hier: Wer in der Nähe ist, sieht es."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No posts yet. Looking for a charger or want to share a snack? Write it here: people nearby will see it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay anuncios. ¿Buscas un cargador o quieres compartir un snack? Escríbelo aquí: lo verá quien esté cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune annonce pour l'instant. Tu cherches un chargeur ou tu veux partager un snack ? Écris-le ici : les personnes à proximité le verront."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen oppslag ennå. Ser du etter en lader, eller vil du dele en snacks? Skriv det her: de i nærheten ser det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen berichten. Zoek je een oplader of wil je een snack delen? Schrijf het hier: mensen in de buurt zien het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na razie brak ogłoszeń. Szukasz ładowarki albo chcesz podzielić się przekąską? Napisz tutaj: zobaczą to osoby w pobliżu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não há anúncios. Procuras um carregador ou queres partilhar um snack? Escreve aqui: quem estiver por perto vai ver."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga inlägg ännu. Letar du efter en laddare eller vill du dela med dig av ett snacks? Skriv det här: de i närheten ser det."
          }
        }
      }
    },
