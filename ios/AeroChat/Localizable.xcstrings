    "Avvisa prima l'equipaggio: usa il pulsante di chiamata sopra il tuo posto. Inviare l'avviso a tutta la cabina?" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt først besætningen: brug kaldeknappen over dit sæde. Sende advarslen til hele kabinen?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informiere zuerst die Crew: Benutze die Ruftaste über deinem Platz. Den Alarm an die ganze Kabine senden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alert the crew first: use the call button above your seat. Send the alert to the whole cabin?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa primero a la tripulación: usa el botón de llamada sobre tu asiento. ¿Enviar el aviso a toda la cabina?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préviens d'abord l'équipage : utilise le bouton d'appel au-dessus de ton siège. Envoyer l'alerte à toute la cabine ?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsle besetningen først: bruk tilkallingsknappen over setet ditt. Sende varselet til hele kabinen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuw eerst de bemanning: gebruik de oproepknop boven je stoel. De melding naar de hele cabine sturen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw powiadom załogę: użyj przycisku wezwania nad swoim miejscem. Wysłać alert do całej kabiny?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa primeiro a tripulação: usa o botão de chamada por cima do teu lugar. Enviar o aviso a toda a cabine?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakta besättningen först: använd anropsknappen ovanför din plats. Skicka varningen till hela kabinen?"
          }
        }
      }
    },
