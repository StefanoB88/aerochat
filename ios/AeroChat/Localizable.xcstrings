    "Fallo adesso, finché c'è rete: in aereo non potrà scaricare AeroChat." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør det nu, mens der er netværk: i flyet kan de ikke downloade AeroChat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach es jetzt, solange es Netz gibt: Im Flugzeug können sie AeroChat nicht mehr herunterladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do it now, while there's a network: they won't be able to download AeroChat on the plane."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazlo ahora, mientras hay red: en el avión no podrá descargar AeroChat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais-le maintenant, tant qu'il y a du réseau : dans l'avion, ils ne pourront pas télécharger AeroChat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør det nå, mens det er nett: på flyet kan de ikke laste ned AeroChat."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe het nu, nu er nog netwerk is: in het vliegtuig kunnen ze AeroChat niet meer downloaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrób to teraz, póki jest sieć: w samolocie nie pobiorą już AeroChat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fá-lo já, enquanto há rede: no avião não vai poder descarregar o AeroChat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör det nu medan det finns nät: på planet kan de inte ladda ner AeroChat."
          }
        }
      }
    },
