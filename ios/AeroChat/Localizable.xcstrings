    "3 amici si sono aggiunti con il tuo invito: il Pass è attivo per 24 ore su questo telefono. Non si può regalare ai gruppi." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 venner er kommet med via din invitation: Passet er aktivt i 24 timer på denne telefon. Det kan ikke gives til grupper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 Freunde sind über deine Einladung dazugekommen: Der Pass ist 24 Stunden auf diesem Handy aktiv. Er kann nicht an Gruppen verschenkt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 friends joined with your invite: the Pass is active for 24 hours on this phone. It can't be gifted to groups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 amigos se han unido con tu invitación: el Pass está activo durante 24 horas en este teléfono. No se puede regalar a los grupos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 amis t'ont rejoint grâce à ton invitation : le Pass est actif pendant 24 heures sur ce téléphone. Il ne peut pas être offert aux groupes."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 venner har blitt med via invitasjonen din: Passet er aktivt i 24 timer på denne telefonen. Det kan ikke gis bort til grupper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 vrienden zijn via je uitnodiging aangesloten: de Pass is 24 uur actief op deze telefoon. Hij kan niet aan groepen worden gegeven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 znajomych dołączyło dzięki Twojemu zaproszeniu: Pass jest aktywny przez 24 godziny na tym telefonie. Nie można go podarować grupom."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 amigos juntaram-se com o teu convite: o Pass está ativo durante 24 horas neste telemóvel. Não pode ser oferecido aos grupos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3 vänner har gått med via din inbjudan: Passet är aktivt i 24 timmar på den här telefonen. Det kan inte ges bort till grupper."
          }
        }
      }
    },
