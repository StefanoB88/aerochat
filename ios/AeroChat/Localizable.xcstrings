        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Generado íntegramente en el dispositivo con Apple Intelligence: ningún mensaje sale del teléfono. Puede contener imprecisiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Généré entièrement sur l’appareil avec Apple Intelligence : aucun message ne quitte le téléphone. Peut contenir des inexactitudes."
