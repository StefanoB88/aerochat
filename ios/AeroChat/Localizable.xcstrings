    "Chattiamo con AeroChat: via Bluetooth, anche in aereo senza Wi-Fi." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lad os chatte på AeroChat: via Bluetooth, selv i flyet uden Wi-Fi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lass uns über AeroChat chatten: per Bluetooth, sogar im Flugzeug ohne Wi-Fi."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
