    "Buon volo! ✈️ Quando vuoi disattivami da Impostazioni › Informazioni." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "God flyvetur! ✈️ Du kan slå mig fra når som helst under Indstillinger › Om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Guten Flug! ✈️ Du kannst mich jederzeit unter Einstellungen › Info deaktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Have a good flight! ✈️ You can turn me off anytime from Settings › About."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "¡Buen vuelo! ✈️ Cuando quieras, desactívame desde Ajustes › Información."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bon vol ! ✈️ Tu peux me désactiver quand tu veux depuis Réglages › À propos."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "God tur! ✈️ Du kan slå meg av når som helst i Innstillinger › Om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Goede vlucht! ✈️ Je kunt me altijd uitschakelen via Instellingen › Info."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Miłego lotu! ✈️ W każdej chwili możesz mnie wyłączyć w Ustawienia › Informacje."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Boa viagem! ✈️ Quando quiseres, desativa-me em Definições › Informações."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Trevlig flygresa! ✈️ Du kan stänga av mig när du vill under Inställningar › Om."
          }
        }
      }
    },
