    "Nella tab Cabina trovi la bacheca pubblica di 12 ore con le regole da accettare." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Under fanen Kabine finder du den offentlige 12-timers opslagstavle med de regler, du skal acceptere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Im Tab „Kabine“ findest du die öffentliche 12-Stunden-Pinnwand mit den Regeln, die du akzeptieren musst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In the Cabin tab you’ll find the 12-hour public board, with the rules to accept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En la pestaña Cabina encontrarás el tablón público de 12 horas con las normas que hay que aceptar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dans l’onglet Cabine, tu trouveras le tableau public de 12 heures, avec les règles à accepter."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I Kabin-fanen finner du den offentlige oppslagstavlen på 12 timer, med reglene du må godta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "In het tabblad Cabine vind je het openbare prikbord van 12 uur, met de regels die je moet accepteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "W karcie Kabina znajdziesz publiczną tablicę 12-godzinną z zasadami do zaakceptowania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No separador Cabine encontras o mural público de 12 horas, com as regras a aceitar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "I fliken Kabin hittar du den offentliga 12-timmarsanslagstavlan med reglerna du behöver godkänna."
          }
        }
      }
    },
