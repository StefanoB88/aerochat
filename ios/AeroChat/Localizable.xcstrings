    "Le coordinate viaggiano solo via Bluetooth, cifrate, verso i telefoni vicini. Nessun server." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koordinaterne sendes kun via Bluetooth, krypteret, til telefoner i nærheden. Ingen server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Koordinaten werden nur über Bluetooth, verschlüsselt, an Telefone in der Nähe gesendet. Kein Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Coordinates travel only over Bluetooth, encrypted, to nearby phones. No server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las coordenadas viajan solo por Bluetooth, cifradas, hacia los teléfonos cercanos. Sin servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les coordonnées ne circulent que via Bluetooth, chiffrées, vers les téléphones à proximité. Aucun serveur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koordinatene sendes bare via Bluetooth, kryptert, til telefoner i nærheten. Ingen server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De coördinaten gaan alleen via Bluetooth, versleuteld, naar telefoons in de buurt. Geen server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Współrzędne są przesyłane wyłącznie przez Bluetooth, zaszyfrowane, do pobliskich telefonów. Bez serwera."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As coordenadas viajam apenas por Bluetooth, cifradas, para os telemóveis próximos. Sem servidores."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koordinaterna skickas bara via Bluetooth, krypterade, till telefoner i närheten. Ingen server."
          }
        }
      }
    },
    "Le foto che ricevi da chi non hai scansionato di persona restano sfocate finché non le tocchi." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Billeder, du modtager fra personer, du ikke har scannet personligt, forbliver slørede, indtil du trykker på dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fotos von Personen, die du nicht persönlich gescannt hast, bleiben unscharf, bis du sie antippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos you receive from people you haven’t scanned in person stay blurred until you tap them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las fotos que recibes de quien no has escaneado en persona permanecen borrosas hasta que las tocas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les photos que tu reçois de personnes que tu n’as pas scannées en personne restent floutées jusqu’à ce que tu les touches."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bilder du mottar fra personer du ikke har skannet personlig, forblir uskarpe til du trykker på dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foto’s die je ontvangt van mensen die je niet persoonlijk hebt gescand, blijven wazig totdat je erop tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zdjęcia otrzymane od osób, których nie zeskanowano osobiście, pozostają rozmyte, dopóki ich nie dotkniesz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As fotografias que recebes de quem não digitalizaste pessoalmente ficam desfocadas até lhes tocares."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foton du får från personer du inte har skannat personligen förblir suddiga tills du trycker på dem."
          }
        }
      }
    },
    "Le foto dei contatti che non hai mai scansionato di persona (membri dei gruppi arrivati via gossip) restano sfocate finché non le tocchi." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Billeder fra kontakter, du aldrig har scannet personligt (gruppemedlemmer, der er kommet til via gossip), forbliver slørede, indtil du trykker på dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fotos von Kontakten, die du nie persönlich gescannt hast (Gruppenmitglieder, die per Gossip dazugekommen sind), bleiben unscharf, bis du sie antippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Photos from contacts you’ve never scanned in person (group members who arrived via gossip) stay blurred until you tap them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las fotos de los contactos que nunca has escaneado en persona (miembros de grupos llegados por gossip) permanecen borrosas hasta que las tocas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les photos des contacts que tu n’as jamais scannés en personne (membres de groupes arrivés via gossip) restent floutées jusqu’à ce que tu les touches."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bilder fra kontakter du aldri har skannet personlig (gruppemedlemmer som kom inn via gossip), forblir uskarpe til du trykker på dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foto’s van contacten die je nooit persoonlijk hebt gescand (groepsleden die via gossip zijn binnengekomen) blijven wazig totdat je erop tikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zdjęcia od kontaktów, których nigdy nie zeskanowano osobiście (członków grup dodanych przez gossip), pozostają rozmyte, dopóki ich nie dotkniesz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As fotografias dos contactos que nunca digitalizaste pessoalmente (membros dos grupos chegados via gossip) ficam desfocadas até lhes tocares."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foton från kontakter du aldrig har skannat personligen (gruppmedlemmar som tillkommit via gossip) förblir suddiga tills du trycker på dem."
          }
        }
      }
    },
