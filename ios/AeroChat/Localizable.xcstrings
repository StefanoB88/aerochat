    },
    "Senza notifiche non saprai quando arriva un messaggio con l'app chiusa. Attivale per AeroChat nelle Impostazioni." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden notifikationer ved du ikke, hvornår der kommer en besked, mens appen er lukket. Slå dem til for AeroChat i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Mitteilungen erfährst du nicht, wenn bei geschlossener App eine Nachricht eintrifft. Aktiviere sie für AeroChat in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without notifications you won’t know when a message arrives while the app is closed. Turn them on for AeroChat in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin notificaciones no sabrás cuándo llega un mensaje con la app cerrada. Actívalas para AeroChat en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans notifications, vous ne saurez pas qu’un message est arrivé quand l’app est fermée. Activez-les pour AeroChat dans Réglages."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten varslinger vet du ikke når en melding kommer mens appen er lukket. Slå dem på for AeroChat i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder meldingen weet je niet wanneer er een bericht binnenkomt als de app gesloten is. Zet ze aan voor AeroChat in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez powiadomień nie dowiesz się o nowej wiadomości, gdy aplikacja jest zamknięta. Włącz je dla AeroChat w Ustawieniach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem notificações não saberá quando chega uma mensagem com a app fechada. Ative-as para o AeroChat nas Definições."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan notiser vet du inte när ett meddelande kommer medan appen är stängd. Slå på dem för AeroChat i Inställningar."
          }
        }
      }
    },
