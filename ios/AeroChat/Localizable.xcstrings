    "Aggiungi compagno (QR)" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tilføj rejsemakker (QR)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reisebuddy hinzufügen (QR)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Add Travel Buddy (QR)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Añadir compañero de viaje (QR)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajouter un compagnon de voyage (QR)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legg til reisekamerat (QR)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voeg reisgenoot toe (QR)"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaj towarzysza podróży (QR)"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adicionar companheiro de viagem (QR)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägg till resekompis (QR)"
          }
        }
      }
    },
    "Aggiungi i compagni di volo al gate: a bordo vi troverete da soli via Bluetooth." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tilføj dine rejsemakkere ved gaten: om bord finder I automatisk hinanden via Bluetooth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Füge deine Reisebuddys am Gate hinzu: An Bord findet ihr euch dann von selbst per Bluetooth."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Add your travel buddies at the gate: once on board, you’ll find each other over Bluetooth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Añade a tus compañeros de viaje en la puerta de embarque: a bordo os encontraréis automáticamente por Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ajoute tes compagnons de voyage à la porte d’embarquement : à bord, vous vous retrouverez automatiquement via Bluetooth."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Legg til reisekameratene ved gaten: om bord finner dere hverandre automatisk via Bluetooth."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voeg je reisgenoten toe bij de gate: aan boord vinden jullie elkaar vanzelf via Bluetooth."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dodaj towarzyszy podróży przy bramce: na pokładzie odnajdziecie się sami przez Bluetooth."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Adiciona os teus companheiros de viagem na porta de embarque: a bordo, encontram-se automaticamente por Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lägg till dina resekompisar vid gaten: ombord hittar ni varandra automatiskt via Bluetooth."
          }
        }
      }
    },
    "Aggiunto %@!" : {
      "localizations" : {
