    "5 domande su viaggi, geografia e aviazione. Chi è a portata di Bluetooth vede la domanda e risponde: vince chi è veloce e preciso." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 spørgsmål om rejser, geografi og luftfart. Alle inden for Bluetooth-rækkevidde ser spørgsmålet og svarer: den hurtigste og mest præcise vinder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 Fragen zu Reisen, Geografie und Luftfahrt. Wer in Bluetooth-Reichweite ist, sieht die Frage und antwortet: Es gewinnt, wer schnell und richtig antwortet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Five questions on travel, geography, and aviation. Anyone within Bluetooth range sees the question and answers: the fastest and most accurate wins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 preguntas sobre viajes, geografía y aviación. Quien esté al alcance del Bluetooth ve la pregunta y responde: gana quien sea más rápido y preciso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 questions sur les voyages, la géographie et l’aviation. Toute personne à portée de Bluetooth voit la question et répond : le plus rapide et le plus précis l’emporte."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 spørsmål om reise, geografi og luftfart. Alle innen Bluetooth-rekkevidde ser spørsmålet og svarer: den raskeste og mest presise vinner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 vragen over reizen, geografie en luchtvaart. Iedereen binnen Bluetooth-bereik ziet de vraag en antwoordt: wie snel en precies is, wint."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 pytań o podróże, geografię i lotnictwo. Każdy w zasięgu Bluetooth widzi pytanie i odpowiada: wygrywa ten, kto jest szybki i dokładny."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 perguntas sobre viagens, geografia e aviação. Quem estiver ao alcance do Bluetooth vê a pergunta e responde: ganha quem for mais rápido e preciso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "5 frågor om resor, geografi och flyg. Alla inom Bluetooth-räckvidd ser frågan och svarar: den som är snabbast och träffsäkrast vinner."
          }
        }
      }
    },
