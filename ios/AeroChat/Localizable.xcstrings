    "Per sempre, su ogni volo, crociera e festival. Nessun abbonamento." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "For altid, på alle fly, krydstogter og festivaler. Intet abonnement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Für immer, auf jedem Flug, jeder Kreuzfahrt und jedem Festival. Kein Abo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Forever, on every flight, cruise, and festival. No subscription."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para siempre, en cada vuelo, crucero y festival. Sin suscripción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pour toujours, sur chaque vol, croisière et festival. Aucun abonnement."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "For alltid, på alle fly, cruise og festivaler. Uten abonnement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Voor altijd, op elke vlucht, cruise en elk festival. Geen abonnement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Na zawsze, na każdym locie, rejsie i festiwalu. Bez abonamentu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Para sempre, em todos os voos, cruzeiros e festivais. Sem subscrição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "För alltid, på varje flyg, kryssning och festival. Ingen prenumeration."
          }
        }
      }
    },
