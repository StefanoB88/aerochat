    "In volo i messaggi passano da telefono a telefono via Bluetooth: niente Wi-Fi, niente rete, niente account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In flight, messages hop from phone to phone via Bluetooth: no Wi-Fi, no network, no account."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Flug gehen Nachrichten per Bluetooth von Handy zu Handy: kein WLAN, kein Netz, kein Konto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vol, les messages passent de téléphone en téléphone via Bluetooth : pas de Wi-Fi, pas de réseau, pas de compte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vuelo los mensajes pasan de teléfono a teléfono por Bluetooth: sin Wi-Fi, sin red, sin cuenta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em voo as mensagens passam de telemóvel em telemóvel por Bluetooth: sem Wi-Fi, sem rede, sem conta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens de vlucht springen berichten via Bluetooth van telefoon naar telefoon: geen wifi, geen netwerk, geen account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W locie wiadomości przechodzą z telefonu na telefon przez Bluetooth: bez Wi-Fi, bez sieci, bez konta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flygningen hoppar meddelanden från telefon till telefon via Bluetooth: inget wifi, inget nät, inget konto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flyvningen hopper beskeder fra telefon til telefon via Bluetooth: ingen wi-fi, intet netværk, ingen konto."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flyturen hopper meldinger fra telefon til telefon via Bluetooth: ikke wifi, ikke nett, ingen konto."
          }
        }
      }
    },
    "In volo l'equipaggio è il primo riferimento." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flyvningen er besætningen din første kontakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Flug ist die Crew die erste Anlaufstelle."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In flight, the crew is your first point of contact."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vuelo, la tripulación es la primera referencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vol, l'équipage est ton premier interlocuteur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flyturen er besetningen din første kontakt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens de vlucht is de bemanning je eerste aanspreekpunt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W locie pierwszym punktem kontaktu jest załoga."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em voo, a tripulação é a primeira referência."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flygningen är besättningen din första kontakt."
          }
        }
      }
    },
    "In volo puoi inviare un avviso ogni 10 minuti: riprova tra %lld min." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flyvningen kan du sende én advarsel hvert 10. minut: prøv igen om %lld min."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Flug kannst du alle 10 Minuten eine Warnung senden: Versuche es in %lld Min. erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In flight you can send one alert every 10 minutes: try again in %lld min."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vuelo puedes enviar un aviso cada 10 minutos: vuelve a intentarlo en %lld min."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vol, tu peux envoyer une alerte toutes les 10 minutes : réessaie dans %lld min."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flyturen kan du sende ett varsel hvert 10. minutt: prøv igjen om %lld min."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens de vlucht kun je elke 10 minuten één melding sturen: probeer het over %lld min opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W locie możesz wysłać jeden alert co 10 minut: spróbuj ponownie za %lld min."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em voo podes enviar um alerta a cada 10 minutos: tenta novamente daqui a %lld min."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under flygningen kan du skicka en varning var 10:e minut: försök igen om %lld min."
          }
        }
      }
