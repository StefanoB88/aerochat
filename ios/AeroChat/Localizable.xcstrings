    "Solo numeri: nessun messaggio, nome o foto di altri passeggeri finisce nella cartolina." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kun tal: ingen beskeder, navne eller billeder af andre passagerer havner på postkortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nur Zahlen: Keine Nachrichten, Namen oder Fotos anderer Passagiere landen auf der Postkarte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Numbers only: no messages, names, or photos of other passengers end up on the postcard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solo números: ningún mensaje, nombre ni foto de otros pasajeros acaba en la postal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Que des chiffres : aucun message, nom ou photo d’autres passagers ne figure sur la carte postale."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bare tall: ingen meldinger, navn eller bilder av andre passasjerer havner på postkortet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alleen cijfers: geen berichten, namen of foto’s van andere passagiers komen op de ansichtkaart terecht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tylko liczby: na pocztówce nie znajdą się żadne wiadomości, nazwy ani zdjęcia innych pasażerów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Só números: nenhuma mensagem, nome ou fotografia de outros passageiros vai parar ao postal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bara siffror: inga meddelanden, namn eller foton av andra passagerare hamnar på vykortet."
          }
        }
      }
    },
