    "Foto, nickname e colore sono visibili ai tuoi compagni di volo e ai membri dei tuoi gruppi." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dit foto, kaldenavn og farve kan ses af dine medrejsende og medlemmerne af dine grupper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Foto, Nickname und Farbe sind für deine Mitreisenden und die Mitglieder deiner Gruppen sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Your photo, nickname and color are visible to your fellow travelers and to members of your groups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu foto, apodo y color son visibles para tus compañeros de vuelo y los miembros de tus grupos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ta photo, ton pseudo et ta couleur sont visibles par tes compagnons de vol et les membres de tes groupes."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bildet, kallenavnet og fargen din er synlige for medreisende og medlemmene i gruppene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je foto, bijnaam en kleur zijn zichtbaar voor je medereizigers en de leden van je groepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zdjęcie, pseudonim i kolor widzą Twoi współpasażerowie oraz członkowie Twoich grup."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A tua fotografia, alcunha e cor são visíveis para os teus companheiros de voo e para os membros dos teus grupos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Din bild, ditt smeknamn och din färg syns för dina medresenärer och medlemmarna i dina grupper."
          }
        }
      }
    },
