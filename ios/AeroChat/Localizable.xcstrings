          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Deel geen telefoonnummer, stoelnummer, documenten of gegevens van andere passagiers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nie udostępniaj numeru telefonu, miejsca, dokumentów ani danych innych pasażerów."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
