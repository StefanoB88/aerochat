    "Si vede solo il nickname. Chi viola le regole può essere bloccato e segnalato da chiunque." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kun dit kaldenavn er synligt. Den, der bryder reglerne, kan blokeres og anmeldes af hvem som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sichtbar ist nur der Nickname. Wer gegen die Regeln verstößt, kann von allen blockiert und gemeldet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Only your nickname is visible. Anyone who breaks the rules can be blocked and reported by anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solo se ve el apodo. Quien incumpla las normas puede ser bloqueado y denunciado por cualquiera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seul le pseudo est visible. Toute personne qui enfreint les règles peut être bloquée et signalée par n’importe qui."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bare kallenavnet er synlig. Den som bryter reglene, kan blokkeres og rapporteres av hvem som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alleen je nickname is zichtbaar. Wie de regels overtreedt, kan door iedereen worden geblokkeerd en gemeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widoczny jest tylko pseudonim. Każdy, kto łamie zasady, może zostać zablokowany i zgłoszony przez kogokolwiek."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Só se vê a alcunha. Quem violar as regras pode ser bloqueado e denunciado por qualquer pessoa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bara smeknamnet syns. Den som bryter mot reglerna kan blockeras och rapporteras av vem som helst."
          }
        }
      }
    },
