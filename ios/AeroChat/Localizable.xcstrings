    "Andata, soggiorno e ritorno. Sblocca il tuo gruppo di viaggio: 1 paga, tutti usano." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Udrejse, ophold og hjemrejse. Lås din rejsegruppe op: Én betaler, alle bruger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Hinflug, Aufenthalt und Rückflug. Schalte deine Reisegruppe frei: Einer zahlt, alle nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "There, your stay, and back. Unlock your travel group: one pays, everyone uses it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ida, estancia y vuelta. Desbloquea tu grupo de viaje: uno paga, todos lo usan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aller, séjour et retour. Débloque ton groupe de voyage : 1 paie, tout le monde en profite."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Utreise, opphold og hjemreise. Lås opp reisegruppen din: én betaler, alle bruker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Heen, verblijf en terug. Ontgrendel je reisgroep: 1 betaalt, iedereen gebruikt het."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tam, pobyt i z powrotem. Odblokuj swoją grupę podróży: 1 płaci, wszyscy korzystają."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ida, estadia e regresso. Desbloqueia o teu grupo de viagem: 1 paga, todos usam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Dit, vistelse och hem igen. Lås upp din resegrupp: en betalar, alla använder."
          }
        }
      }
    },
    "Android: puoi passare l'app senza internet con Quick Share. Apri il Play Store › il tuo profilo › Gestisci app e dispositivo › Condividi app, scegli AeroChat e il telefono vicino." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: du kan dele appen uden internet med Quick Share. Åbn Play Butik › din profil › Administrer apps og enhed › Del apps, og vælg AeroChat og telefonen i nærheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: Du kannst die App ohne Internet mit Quick Share weitergeben. Öffne den Play Store › dein Profil › Apps und Gerät verwalten › Apps teilen, wähle AeroChat und das Handy in der Nähe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: you can pass the app on without internet using Quick Share. Open the Play Store › your profile › Manage apps & device › Share apps, then pick AeroChat and the nearby phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: puedes pasar la app sin internet con Quick Share. Abre Play Store › tu perfil › Gestionar aplicaciones y dispositivo › Compartir aplicaciones, elige AeroChat y el teléfono cercano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android : tu peux transmettre l'app sans internet avec Quick Share. Ouvre le Play Store › ton profil › Gérer les applications et l'appareil › Partager des applications, puis choisis AeroChat et le téléphone à proximité."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: du kan dele appen uten internett med Quick Share. Åpne Play Butikk › profilen din › Administrer apper og enheter › Del apper, og velg AeroChat og telefonen i nærheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: je kunt de app zonder internet doorgeven met Quick Share. Open de Play Store › je profiel › Apps en apparaat beheren › Apps delen, kies AeroChat en de telefoon in de buurt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: możesz przekazać aplikację bez internetu przez Quick Share. Otwórz Sklep Play › swój profil › Zarządzaj aplikacjami i urządzeniem › Udostępnij aplikacje, wybierz AeroChat i telefon w pobliżu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: podes passar a app sem internet com o Quick Share. Abre a Play Store › o teu perfil › Gerir apps e dispositivo › Partilhar apps, escolhe o AeroChat e o telemóvel próximo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android: du kan dela appen utan internet med Quick Share. Öppna Play Butik › din profil › Hantera appar och enheter › Dela appar, välj AeroChat och telefonen i närheten."
          }
        }
      }
    },
