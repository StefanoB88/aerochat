        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ krijgt je uitdaging: accepteert die, dan begint het spel meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ otrzyma wyzwanie: jeśli je przyjmie, gra zacznie się od razu."
