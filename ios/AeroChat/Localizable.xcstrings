    "iPhone: non è possibile installare app senza internet. AeroChat va scaricata prima dell'imbarco." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone: apps kan ikke installeres uden internet. AeroChat skal downloades før boarding."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone: Ohne Internet lassen sich keine Apps installieren. AeroChat muss vor dem Boarding heruntergeladen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone: apps can't be installed without internet. AeroChat must be downloaded before boarding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone: no se pueden instalar apps sin internet. AeroChat debe descargarse antes del embarque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone : impossible d'installer des apps sans internet. AeroChat doit être téléchargée avant l'embarquement."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone: apper kan ikke installeres uten internett. AeroChat må lastes ned før ombordstigning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
