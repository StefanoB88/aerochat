    "Fai inquadrare questo codice al tuo compagno di volo: vi riconoscerete per sempre, anche sul volo di ritorno." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lad din rejsemakker scanne denne kode: Så genkender I hinanden for altid, også på hjemrejsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lass deinen Reisebuddy diesen Code scannen: Ihr erkennt euch dann für immer wieder, auch auf dem Rückflug."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Have your travel buddy scan this code: you’ll recognize each other forever, even on the return flight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pide a tu compañero de viaje que escanee este código: os reconoceréis para siempre, incluso en el vuelo de vuelta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fais scanner ce code à ton compagnon de voyage : vous vous reconnaîtrez pour toujours, même sur le vol retour."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La reisekameraten skanne denne koden: dere kjenner igjen hverandre for alltid, også på returflyet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laat je reisgenoot deze code scannen: jullie herkennen elkaar dan voor altijd, ook op de terugvlucht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Poproś towarzysza podróży o zeskanowanie tego kodu: rozpoznacie się już na zawsze, nawet w locie powrotnym."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pede ao teu companheiro de viagem para apontar a câmara a este código: vão reconhecer-se para sempre, até no voo de regresso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Låt din resekompis skanna den här koden: ni känner igen varandra för alltid, även på returflyget."
          }
        }
      }
    },
    "Fai scaricare l'app ai compagni di volo adesso, finché c'è ancora 4G: a bordo basterà il Bluetooth." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Få dine rejsemakkere til at hente appen nu, mens der stadig er 4G: Om bord er Bluetooth nok."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Lass deine Reisebuddys die App jetzt laden, solange es noch 4G gibt: An Bord reicht dann Bluetooth."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Get your travel buddies to download the app now, while there’s still 4G: on board, Bluetooth is all you need."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Haz que tus compañeros de viaje descarguen la app ahora, mientras aún hay 4G: a bordo bastará con el Bluetooth."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Fais télécharger l’app à tes compagnons de voyage maintenant, tant qu’il y a encore de la 4G : à bord, le Bluetooth suffira."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Få reisekameratene til å laste ned appen nå, mens det fortsatt er 4G: om bord holder det med Bluetooth."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Laat je reisgenoten de app nu downloaden, zolang er nog 4G is: aan boord is Bluetooth genoeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Niech towarzysze podróży pobiorą aplikację już teraz, póki jest jeszcze 4G: na pokładzie wystarczy Bluetooth."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Faz com que os teus companheiros de viagem descarreguem a app agora, enquanto ainda há 4G: a bordo, basta o Bluetooth."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Låt dina resekompisar hämta appen nu, medan det fortfarande finns 4G: ombord räcker det med Bluetooth."
          }
        }
      }
    },
