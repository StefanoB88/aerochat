    "Le chat di gruppo da 3+ persone si attivano con il Flight Group Pass di un solo membro. Potrai comunque creare il gruppo e mostrare il QR." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gruppechats med 3+ personer låses op med ét medlems Flight Group Pass. Du kan stadig oprette gruppen og vise QR-koden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gruppenchats mit 3+ Personen werden mit dem Flight Group Pass eines einzigen Mitglieds freigeschaltet. Du kannst die Gruppe trotzdem erstellen und den QR-Code zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Group chats of 3+ people unlock with just one member’s Flight Group Pass. You can still create the group and show the QR code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los chats de grupo de 3+ personas se activan con el Flight Group Pass de un solo miembro. Aun así podrás crear el grupo y mostrar el QR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les discussions de groupe de 3+ personnes s’activent avec le Flight Group Pass d’un seul membre. Tu pourras quand même créer le groupe et afficher le QR code."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gruppechatter med 3+ personer låses opp med Flight Group Pass fra ett enkelt medlem. Du kan uansett opprette gruppen og vise QR-koden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Groepschats met 3+ personen worden geactiveerd met de Flight Group Pass van één lid. Je kunt de groep toch aanmaken en de QR-code tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Czaty grupowe dla 3+ osób aktywują się dzięki Flight Group Pass tylko jednego członka. Grupę i tak możesz utworzyć i pokazać kod QR."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As conversas de grupo com 3+ pessoas ativam-se com o Flight Group Pass de um único membro. Ainda assim, podes criar o grupo e mostrar o QR."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Gruppchattar med 3+ personer aktiveras med Flight Group Pass från en enda medlem. Du kan ändå skapa gruppen och visa QR-koden."
          }
        }
      }
    },
    "Le chiamate funzionano solo con il compagno a portata diretta, senza ponti." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Opkald virker kun, når rejsekammeraten er inden for direkte rækkevidde, uden relæ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anrufe funktionieren nur mit einem Mitreisenden in direkter Reichweite, ohne Zwischenstationen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Calls only work with a travel buddy in direct range, with no relays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las llamadas solo funcionan con el compañero al alcance directo, sin puentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les appels ne fonctionnent qu’avec un compagnon à portée directe, sans relais."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anrop fungerer bare når reisekameraten er innen direkte rekkevidde, uten mellomledd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Oproepen werken alleen met een reisgenoot binnen direct bereik, zonder tussenstations."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Połączenia działają tylko z towarzyszem podróży w bezpośrednim zasięgu, bez przekaźników."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "As chamadas só funcionam com o companheiro ao alcance direto, sem pontes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Samtal fungerar bara med en resekamrat inom direkt räckhåll, utan reläer."
          }
        }
      }
    },
    "Le chiavi crittografiche vengono generate sul tuo iPhone e non lasciano mai il dispositivo. Niente email, niente numero di telefono." : {
      "localizations" : {
        "da" : {
          "variations" : {
            "device" : {
              "ipad" : {
