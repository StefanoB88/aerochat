    "Tutti i passeggeri che inseriscono lo stesso volo e la stessa data entrano nella stessa stanza cifrata, senza scambiarsi QR." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle passagerer, der indtaster samme fly og samme dato, kommer ind i det samme krypterede rum uden at skulle udveksle QR-koder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle Passagiere, die denselben Flug und dasselbe Datum eingeben, landen im selben verschlüsselten Raum – ganz ohne QR-Codes auszutauschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "All passengers who enter the same flight and date join the same encrypted room, with no QR codes to exchange."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos los pasajeros que introducen el mismo vuelo y la misma fecha entran en la misma sala cifrada, sin intercambiar códigos QR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tous les passagers qui saisissent le même vol et la même date rejoignent la même salle chiffrée, sans échanger de QR."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle passasjerer som skriver inn samme flyvning og samme dato, havner i det samme krypterte rommet, uten å måtte utveksle QR-koder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle passagiers die dezelfde vlucht en datum invoeren, komen in dezelfde versleutelde ruimte terecht, zonder QR-codes uit te wisselen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wszyscy pasażerowie, którzy wpiszą ten sam lot i tę samą datę, trafiają do tego samego zaszyfrowanego pokoju, bez wymiany kodów QR."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todos os passageiros que introduzirem o mesmo voo e a mesma data entram na mesma sala cifrada, sem trocar códigos QR."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alla passagerare som anger samma flight och datum hamnar i samma krypterade rum, utan att behöva byta QR-koder med varandra."
          }
        }
      }
    },
