            "value" : "Rejsemakkeren er uden for rækkevidde: teksten sættes i kø, og medier sendes, så snart I er inden for rækkevidde igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reisebuddy außer Reichweite: Text wird in die Warteschlange gestellt, Medien gehen raus, sobald ihr wieder in Reichweite seid."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Travel buddy out of range: text is queued, and media goes out as soon as you’re back in range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Compañero fuera de alcance: el texto se pone en cola y los archivos multimedia se envían en cuanto volváis a estar al alcance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Compagnon hors de portée : le texte est mis en file d’attente, les médias partent dès que vous êtes de nouveau à portée."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reisekameraten er utenfor rekkevidde: teksten legges i kø, og medier sendes så snart dere er innen rekkevidde igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Reisgenoot buiten bereik: tekst komt in de wachtrij, media worden verstuurd zodra jullie weer binnen bereik zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Towarzysz podróży poza zasięgiem: tekst trafia do kolejki, a media wyślą się, gdy tylko znów będziecie w zasięgu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Companheiro fora de alcance: o texto fica em fila e os ficheiros multimédia são enviados assim que voltarem a estar ao alcance."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Resekompisen är utom räckhåll: texten läggs i kö och media skickas så fort ni är inom räckhåll igen."
