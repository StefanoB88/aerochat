    "Messaggi e media verranno cancellati da questo iPhone." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beskeder og medier slettes fra denne iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nachrichten und Medien werden von diesem iPhone gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Messages and media will be deleted from this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Los mensajes y archivos multimedia se eliminarán de este iPhone."
          }
