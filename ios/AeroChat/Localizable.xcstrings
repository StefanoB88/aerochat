    "Solo i passeggeri del tuo stesso volo vedono il posto. Spento di default." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun passagerer på dit eget fly kan se sædet. Slået fra som standard."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Passagiere deines eigenen Flugs sehen den Platz. Standardmäßig aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only passengers on your own flight see your seat. Off by default."
          }
        },
