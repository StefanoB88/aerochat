    "Le coordinate viaggiano solo via Bluetooth, cifrate, verso i telefoni vicini. Nessun server." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koordinaterne sendes kun via Bluetooth, krypteret, til telefoner i nærheden. Ingen server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Koordinaten werden nur über Bluetooth, verschlüsselt, an Telefone in der Nähe gesendet. Kein Server."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Coordinates travel only over Bluetooth, encrypted, to nearby phones. No server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Las coordenadas viajan solo por Bluetooth, cifradas, hacia los teléfonos cercanos. Sin servidores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Les coordonnées ne circulent que via Bluetooth, chiffrées, vers les téléphones à proximité. Aucun serveur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Koordinatene sendes bare via Bluetooth, kryptert, til telefoner i nærheten. Ingen server."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De coördinaten gaan alleen via Bluetooth, versleuteld, naar telefoons in de buurt. Geen server."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Współrzędne są przesyłane wyłącznie przez Bluetooth, zaszyfrowane, do pobliskich telefonów. Bez serwera."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
