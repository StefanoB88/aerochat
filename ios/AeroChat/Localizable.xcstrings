    "Restate a meno di 30 metri, con pochi sedili in mezzo: il Bluetooth non attraversa bene corpi e bagagli." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold jer inden for 30 meter med få sæder imellem: Bluetooth går dårligt gennem kroppe og bagage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt unter 30 Metern, mit wenigen Sitzen dazwischen: Bluetooth kommt schlecht durch Körper und Gepäck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stay within 30 metres, with only a few seats in between: Bluetooth doesn't pass well through bodies and luggage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedaos a menos de 30 metros, con pocos asientos en medio: el Bluetooth atraviesa mal cuerpos y equipaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restez à moins de 30 mètres, avec peu de sièges entre vous : le Bluetooth traverse mal les corps et les bagages."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold dere innenfor 30 meter, med få seter imellom: Bluetooth går dårlig gjennom kropper og bagasje."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blijf binnen 30 meter, met weinig stoelen ertussen: Bluetooth gaat slecht door lichamen en bagage."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bądźcie w odległości do 30 metrów, z niewieloma fotelami pomiędzy: Bluetooth słabo przenika przez ludzi i bagaże."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiquem a menos de 30 metros, com poucos bancos pelo meio: o Bluetooth atravessa mal corpos e bagagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll er inom 30 meter, med få säten emellan: Bluetooth går dåligt genom kroppar och bagage."
          }
        }
      }
    },
