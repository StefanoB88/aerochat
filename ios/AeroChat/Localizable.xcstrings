    "Chi inquadra questo codice entra nel gruppo \"%@\" e riceve automaticamente gli altri membri." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle, der scanner denne kode, kommer med i gruppen “%@” og får automatisk de andre medlemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wer diesen Code scannt, tritt der Gruppe „%@“ bei und erhält automatisch die anderen Mitglieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anyone who scans this code joins the group “%@” and automatically gets the other members."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quien escanee este código entra en el grupo “%@” y recibe automáticamente a los demás miembros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quiconque scanne ce code rejoint le groupe « %@ » et reçoit automatiquement les autres membres."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle som skanner denne koden, blir med i gruppen «%@» og får automatisk de andre medlemmene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie deze code scant, komt in de groep '%@' en krijgt automatisch de andere leden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kto zeskanuje ten kod, dołączy do grupy „%@” i automatycznie połączy się z pozostałymi członkami."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quem ler este código entra no grupo “%@” e recebe automaticamente os outros membros."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alla som skannar den här koden går med i gruppen ”%@” och får automatiskt de andra medlemmarna."
          }
        }
      }
