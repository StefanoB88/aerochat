    "Messaggi tra sedili, senza Wi-Fi e senza account. Solo un nickname." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Beskeder fra sæde til sæde, uden Wi-Fi og uden konto. Bare et kaldenavn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nachrichten von Sitz zu Sitz, ohne WLAN und ohne Account. Nur ein Nickname."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Seat-to-seat messaging, no Wi-Fi and no account. Just a nickname."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mensajes entre asientos, sin Wi‑Fi y sin cuenta. Solo un apodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Messages de siège à siège, sans Wi-Fi ni compte. Juste un pseudo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meldinger fra sete til sete, uten Wi-Fi og uten konto. Bare et kallenavn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Berichten van stoel naar stoel, zonder wifi en zonder account. Alleen een nickname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wiadomości od fotela do fotela, bez Wi‑Fi i bez konta. Wystarczy nick."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Mensagens entre assentos, sem Wi‑Fi nem conta. Só um nickname."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Meddelanden från säte till säte, utan Wi-Fi och utan konto. Bara ett smeknamn."
          }
        }
      }
