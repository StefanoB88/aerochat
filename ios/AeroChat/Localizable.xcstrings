    "La segnalazione è salvata sul tuo iPhone. Se hai rete puoi inoltrarla al team di sicurezza: esaminiamo ogni rapporto entro 24 ore." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anmeldelsen er gemt på din iPhone. Hvis du har forbindelse, kan du videresende den til sikkerhedsteamet: vi gennemgår alle rapporter inden for 24 timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Meldung ist auf deinem iPhone gespeichert. Wenn du Netz hast, kannst du sie an das Sicherheitsteam weiterleiten: Wir prüfen jeden Bericht innerhalb von 24 Stunden."
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "ipad" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "The report is saved on your iPad. If you have a connection, you can forward it to the safety team: every report is reviewed within 24 hours."
                }
              },
              "iphone" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "The report is saved on your iPhone. If you have a connection, you can forward it to the safety team: every report is reviewed within 24 hours."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "machine_translated",
                  "value" : "The report is saved on your device. If you have a connection, you can forward it to the safety team: every report is reviewed within 24 hours."
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La denuncia se guarda en tu iPhone. Si tienes conexión, puedes enviarla al equipo de seguridad: revisamos cada informe en un plazo de 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Le signalement est enregistré sur ton iPhone. Si tu as du réseau, tu peux le transmettre à l’équipe de sécurité : nous examinons chaque rapport sous 24 heures."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rapporten er lagret på iPhonen din. Hvis du har dekning, kan du videresende den til sikkerhetsteamet: vi gjennomgår alle rapporter innen 24 timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De melding is opgeslagen op je iPhone. Als je verbinding hebt, kun je hem doorsturen naar het veiligheidsteam: we bekijken elk rapport binnen 24 uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zgłoszenie jest zapisane na Twoim iPhonie. Jeśli masz zasięg, możesz przekazać je zespołowi ds. bezpieczeństwa: każde zgłoszenie rozpatrujemy w ciągu 24 godzin."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A denúncia está guardada no teu iPhone. Se tiveres rede, podes encaminhá-la para a equipa de segurança: analisamos cada relatório em 24 horas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Rapporten sparas på din iPhone. Om du har uppkoppling kan du vidarebefordra den till säkerhetsteamet: vi granskar varje rapport inom 24 timmar."
          }
        }
      }
    },
