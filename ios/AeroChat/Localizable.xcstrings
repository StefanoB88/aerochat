    "La Cabina si svuota ogni 12 ore e resta solo sui telefoni a bordo." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kabinen tømmes hver 12. time og findes kun på telefonerne om bord."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die Kabine leert sich alle 12 Stunden und existiert nur auf den Telefonen an Bord."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The Cabin empties every 12 hours and lives only on the phones on board."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La Cabina se vacía cada 12 horas y solo queda en los teléfonos a bordo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La Cabine se vide toutes les 12 heures et ne reste que sur les téléphones à bord."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kabinen tømmes hver 12. time og finnes bare på telefonene om bord."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De cabine wordt elke 12 uur geleegd en blijft alleen op de telefoons aan boord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kabina opróżnia się co 12 godzin i istnieje tylko na telefonach na pokładzie."
