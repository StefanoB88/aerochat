    "Ti avvisiamo quando qualcuno ti saluta o ti scrive." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi giver dig besked, når nogen hilser på dig eller skriver til dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir sagen dir Bescheid, wenn dich jemand grüßt oder dir schreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll let you know when someone says hi or writes to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisamos cuando alguien te saluda o te escribe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On te prévient quand quelqu'un te salue ou t'écrit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi gir deg beskjed når noen hilser på deg eller skriver til deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We laten het je weten wanneer iemand je groet of je schrijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damy Ci znać, gdy ktoś Cię pozdrowi lub do Ciebie napisze."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisamos-te quando alguém te cumprimenta ou te escreve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi meddelar dig när någon hälsar eller skriver till dig."
          }
        }
      }
    },
    "Ti va di scambiare il posto?" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du lyst til at bytte sæde?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du Lust, die Plätze zu tauschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Would you like to swap seats?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Te apetece cambiar de asiento?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ça te dirait d'échanger nos sièges ?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du lyst til å bytte sete?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zin om van stoel te ruilen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamienimy się miejscami?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queres trocar de lugar?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du byta plats?"
          }
        }
      }
    },
