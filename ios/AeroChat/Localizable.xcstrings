    "Un utente bloccato non può più scriverti e i suoi messaggi non vengono ritrasmessi dal tuo telefono. Puoi sbloccarlo da Impostazioni › Utenti bloccati." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En blokeret bruger kan ikke længere skrive til dig, og vedkommendes beskeder videresendes ikke af din telefon. Du kan fjerne blokeringen under Indstillinger › Blokerede brugere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein blockierter Nutzer kann dir nicht mehr schreiben, und seine Nachrichten werden von deinem Telefon nicht mehr weitergeleitet. Du kannst die Blockierung unter Einstellungen › Blockierte Nutzer aufheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A blocked user can no longer message you, and their messages aren’t relayed by your phone. You can unblock them from Settings › Blocked Users."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un usuario bloqueado ya no puede escribirte y tu teléfono no retransmite sus mensajes. Puedes desbloquearlo desde Ajustes › Usuarios bloqueados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un utilisateur bloqué ne peut plus t’écrire et ses messages ne sont plus relayés par ton téléphone. Tu peux le débloquer depuis Réglages › Utilisateurs bloqués."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En blokkert bruker kan ikke lenger skrive til deg, og meldingene vedkommende sender, videresendes ikke av telefonen din. Du kan oppheve blokkeringen i Innstillinger › Blokkerte brukere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een geblokkeerde gebruiker kan je niet meer schrijven en zijn berichten worden niet meer door je telefoon doorgestuurd. Je kunt de blokkering opheffen via Instellingen › Geblokkeerde gebruikers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zablokowany użytkownik nie może już do Ciebie pisać, a jego wiadomości nie są przekazywane dalej przez Twój telefon. Możesz go odblokować w Ustawienia › Zablokowani użytkownicy."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um utilizador bloqueado deixa de poder escrever-te e as suas mensagens não são retransmitidas pelo teu telemóvel. Podes desbloqueá-lo em Definições › Utilizadores bloqueados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En blockerad användare kan inte längre skriva till dig, och hens meddelanden vidarebefordras inte av din telefon. Du kan avblockera från Inställningar › Blockerade användare."
          }
        }
      }
    },
    "Un volo, un giorno. Foto, vocali e giochi per te e per il tuo gruppo fino all'atterraggio." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ét fly, én dag. Billeder, talebeskeder og spil til dig og din gruppe indtil landing."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ein Flug, ein Tag. Fotos, Sprachnachrichten und Spiele für dich und deine Gruppe bis zur Landung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "One flight, one day. Photos, voice notes, and games for you and your group until landing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un vuelo, un día. Fotos, notas de voz y juegos para ti y tu grupo hasta el aterrizaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un vol, une journée. Photos, notes vocales et jeux pour toi et ton groupe jusqu’à l’atterrissage."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Én flyvning, én dag. Bilder, talemeldinger og spill for deg og gruppen din frem til landing."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eén vlucht, één dag. Foto’s, spraakberichten en games voor jou en je groep tot aan de landing."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Jeden lot, jeden dzień. Zdjęcia, notatki głosowe i gry dla Ciebie i Twojej grupy aż do lądowania."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um voo, um dia. Fotografias, notas de voz e jogos para ti e para o teu grupo até à aterragem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En flygresa, en dag. Foton, röstmeddelanden och spel för dig och din grupp fram till landningen."
          }
        }
      }
    },
    "Una bacheca tra i passeggeri a portata di Bluetooth. Per restare piacevole per tutti ha poche regole semplici." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En opslagstavle for passagerer inden for Bluetooth-rækkevidde. For at den skal blive ved med at være rar for alle, har den nogle få enkle regler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Eine Pinnwand für Passagiere in Bluetooth-Reichweite. Damit sie für alle angenehm bleibt, gibt es ein paar einfache Regeln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A message board for passengers within Bluetooth range. To keep it pleasant for everyone, it has a few simple rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un tablón entre los pasajeros al alcance del Bluetooth. Para que siga siendo agradable para todos, tiene unas pocas normas sencillas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Un tableau d’affichage entre passagers à portée de Bluetooth. Pour rester agréable pour tous, il a quelques règles simples."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En oppslagstavle for passasjerer innen Bluetooth-rekkevidde. For at den skal være hyggelig for alle, har den noen få enkle regler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Een prikbord voor passagiers binnen Bluetooth-bereik. Om het voor iedereen prettig te houden, gelden er een paar simpele regels."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tablica dla pasażerów w zasięgu Bluetooth. Żeby było przyjemnie dla wszystkich, ma kilka prostych zasad."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Um mural entre os passageiros ao alcance do Bluetooth. Para continuar agradável para todos, tem poucas regras simples."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "En anslagstavla för passagerare inom Bluetooth-räckvidd. För att den ska förbli trevlig för alla har den några få enkla regler."
          }
        }
      }
    },
