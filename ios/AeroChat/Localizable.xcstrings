    "Chi ha AeroChat aperta qui vicino comparirà da solo. Fai scaricare l'app a chi è con te: basta inquadrare il tuo QR." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyone nearby with AeroChat open will show up on their own. Get the people with you to download the app: they just scan your QR code."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in der Nähe AeroChat offen hat, erscheint von selbst. Lass deine Begleiter die App laden: Sie scannen einfach deinen QR-Code."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes proches avec AeroChat ouverte apparaîtront toutes seules. Fais télécharger l'app à ceux qui t'accompagnent : il suffit de scanner ton QR."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga AeroChat abierta cerca aparecerá solo. Haz que quien va contigo descargue la app: basta con escanear tu QR."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem tiver o AeroChat aberto por perto aparece sozinho. Faz quem está contigo descarregar a app: basta ler o teu QR."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie in de buurt AeroChat open heeft, verschijnt vanzelf. Laat je reisgenoten de app downloaden: ze scannen gewoon je QR-code."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby w pobliżu z otwartym AeroChat pojawią się same. Poproś towarzyszy, by pobrali aplikację: wystarczy zeskanować twój kod QR."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som har AeroChat öppen i närheten dyker upp av sig själv. Låt dina medresenärer ladda ner appen: de skannar bara din QR-kod."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folk i nærheden med AeroChat åben dukker selv op. Få dem, du rejser med, til at hente appen: de skal bare scanne din QR-kode."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De i nærheten med AeroChat åpen dukker opp av seg selv. Få de du reiser med til å laste ned appen: de skanner bare QR-koden din."
          }
        }
      }
    },
    "Chi ha AeroChat aperto vicino a te vede il tuo nickname e può salutarti." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den, der har AeroChat åben i nærheden af dig, kan se dit kaldenavn og sige hej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wer in deiner Nähe AeroChat geöffnet hat, sieht deinen Nicknamen und kann dich begrüßen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "People near you with AeroChat open can see your nickname and say hi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quien tenga AeroChat abierto cerca de ti ve tu apodo y puede saludarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceux qui ont AeroChat ouvert près de toi voient ton pseudo et peuvent te saluer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De som har AeroChat åpent nær deg, ser kallenavnet ditt og kan si hei."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie AeroChat open heeft in jouw buurt ziet je nickname en kan je begroeten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby z otwartym AeroChatem w pobliżu widzą Twój pseudonim i mogą się z Tobą przywitać."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quem tem o AeroChat aberto perto de ti vê o teu nickname e pode cumprimentar-te."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den som har AeroChat öppet nära dig ser ditt smeknamn och kan säga hej."
          }
        }
      }
    },
    "Chi inquadra questo codice entra nel gruppo \"%@\" e riceve automaticamente gli altri membri." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle, der scanner denne kode, kommer med i gruppen “%@” og får automatisk de andre medlemmer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wer diesen Code scannt, tritt der Gruppe „%@“ bei und erhält automatisch die anderen Mitglieder."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Anyone who scans this code joins the group “%@” and automatically gets the other members."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quien escanee este código entra en el grupo “%@” y recibe automáticamente a los demás miembros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quiconque scanne ce code rejoint le groupe « %@ » et reçoit automatiquement les autres membres."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle som skanner denne koden, blir med i gruppen «%@» og får automatisk de andre medlemmene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Wie deze code scant, komt in de groep '%@' en krijgt automatisch de andere leden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kto zeskanuje ten kod, dołączy do grupy „%@” i automatycznie połączy się z pozostałymi członkami."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Quem ler este código entra no grupo “%@” e recebe automaticamente os outros membros."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alla som skannar den här koden går med i gruppen ”%@” och får automatiskt de andra medlemmarna."
          }
        }
      }
    },
