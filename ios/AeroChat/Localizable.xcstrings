    "La bacheca della cabina: annunci brevi visibili a chi è vicino, per 6 ore al massimo." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabinens opslagstavle: korte opslag, som personer i nærheden kan se, i højst 6 timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Pinnwand der Kabine: kurze Anzeigen für Personen in der Nähe, höchstens 6 Stunden lang."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The cabin board: short posts visible to people nearby, for 6 hours at most."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tablón de la cabina: anuncios breves visibles para quien está cerca, durante 6 horas como máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tableau de la cabine : de courtes annonces visibles par les personnes à proximité, pendant 6 heures au maximum."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kabinens oppslagstavle: korte oppslag som personer i nærheten ser, i høyst 6 timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het prikbord van de cabine: korte berichten die mensen in de buurt zien, maximaal 6 uur lang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tablica kabiny: krótkie ogłoszenia widoczne dla osób w pobliżu, maksymalnie przez 6 godzin."
