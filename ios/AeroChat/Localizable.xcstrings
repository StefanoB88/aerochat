    "Prova a tenere premuto un mio messaggio: puoi segnalarlo o bloccarmi." : {
      "extractionState" : "stale",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prøv at holde en af mine beskeder nede: du kan anmelde den eller blokere mig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Halte eine meiner Nachrichten gedrückt: Du kannst sie melden oder mich blockieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Try touching and holding one of my messages: you can report it or block me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prueba a mantener pulsado uno de mis mensajes: puedes denunciarlo o bloquearme."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Essaie de maintenir le doigt sur l’un de mes messages : tu peux le signaler ou me bloquer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prøv å holde inne en av meldingene mine: du kan rapportere den eller blokkere meg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Houd een van mijn berichten ingedrukt: je kunt het melden of mij blokkeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Spróbuj przytrzymać jedną z moich wiadomości: możesz ją zgłosić albo mnie zablokować."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Experimenta manter premida uma mensagem minha: podes denunciá-la ou bloquear-me."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Testa att hålla fingret på ett av mina meddelanden: du kan rapportera det eller blockera mig."
          }
        }
      }
    },
