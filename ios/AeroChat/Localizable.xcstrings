    "Da invisibile continui a vedere chi è vicino, ma nessuno vede te. Nessuno diventa tuo contatto finché non accetti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When invisible you still see who's nearby, but nobody sees you. Nobody becomes your contact until you accept."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unsichtbar siehst du weiterhin, wer in der Nähe ist, aber niemand sieht dich. Niemand wird dein Kontakt, bevor du annimmst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invisible, tu vois toujours qui est proche, mais personne ne te voit. Personne ne devient ton contact sans ton accord."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invisible sigues viendo quién está cerca, pero nadie te ve. Nadie se convierte en tu contacto hasta que aceptes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invisível continuas a ver quem está perto, mas ninguém te vê. Ninguém se torna teu contacto até aceitares."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onzichtbaar zie je nog steeds wie er in de buurt is, maar niemand ziet jou. Niemand wordt je contact tot je accepteert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jako niewidoczny nadal widzisz, kto jest w pobliżu, ale nikt nie widzi ciebie. Nikt nie zostanie twoim kontaktem, dopóki nie zaakceptujesz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som osynlig ser du fortfarande vem som är nära, men ingen ser dig. Ingen blir din kontakt förrän du accepterar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som usynlig kan du stadig se, hvem der er i nærheden, men ingen ser dig. Ingen bliver din kontakt, før du accepterer."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
