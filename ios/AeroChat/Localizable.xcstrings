    "Notifiche disattivate: non saprai quando qualcuno ti saluta o ti scrive." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer er slået fra: du opdager ikke, når nogen hilser på dig eller skriver til dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind aus: Du merkst nicht, wenn dich jemand grüßt oder dir schreibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are off: you won't know when someone says hi or writes to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificaciones desactivadas: no sabrás cuándo alguien te saluda o te escribe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications désactivées : tu ne sauras pas quand quelqu'un te salue ou t'écrit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler er av: du merker ikke når noen hilser på deg eller skriver til deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen staan uit: je merkt niet wanneer iemand je groet of je schrijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia wyłączone: nie dowiesz się, gdy ktoś Cię pozdrowi lub do Ciebie napisze."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificações desativadas: não vais saber quando alguém te cumprimenta ou te escreve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aviseringar är avstängda: du märker inte när någon hälsar eller skriver till dig."
          }
        }
      }
    },
    "Numeri di tutti i tuoi voli con AeroChat, aggiornati alla fine di ogni volo. Restano solo su questo telefono." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tal fra alle dine flyvninger med AeroChat, opdateret ved slutningen af hver flyvning. De bliver kun på denne telefon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlen aller deiner Flüge mit AeroChat, aktualisiert am Ende jedes Flugs. Sie bleiben nur auf diesem Handy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numbers from all your flights with AeroChat, updated at the end of each flight. They stay on this phone only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cifras de todos tus vuelos con AeroChat, actualizadas al final de cada vuelo. Se quedan solo en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les chiffres de tous tes vols avec AeroChat, mis à jour à la fin de chaque vol. Ils restent uniquement sur ce téléphone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tall fra alle flyturene dine med AeroChat, oppdatert på slutten av hver flytur. De blir bare på denne telefonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De cijfers van al je vluchten met AeroChat, bijgewerkt aan het einde van elke vlucht. Ze blijven alleen op deze telefoon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczby ze wszystkich Twoich lotów z AeroChat, aktualizowane po każdym locie. Zostają tylko na tym telefonie."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os números de todos os teus voos com o AeroChat, atualizados no fim de cada voo. Ficam só neste telemóvel."
