    "Sei invisibile: non comparirai agli altri, ma continui a vederli." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er usynlig: andre ser dig ikke, men du kan se dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist unsichtbar: Andere sehen dich nicht, du siehst sie aber weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’re invisible: others won’t see you, but you can still see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres invisible: los demás no te verán, pero tú sigues viéndolos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es invisible : les autres ne te verront pas, mais tu continues à les voir."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er usynlig: andre ser deg ikke, men du ser dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent onzichtbaar: anderen zien jou niet, maar jij ziet hen nog wel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś niewidoczny: inni Cię nie zobaczą, ale Ty nadal ich widzisz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás invisível: os outros não te vêem, mas tu continuas a vê-los."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är osynlig: andra ser dig inte, men du ser dem."
          }
        }
      }
    },
    "Sei invisibile: vedi gli altri, ma nessuno vede te. Puoi cambiarlo in Impostazioni › Privacy." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're invisible: you see others, but nobody sees you. You can change this in Settings › Privacy."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist unsichtbar: Du siehst andere, aber niemand sieht dich. Ändern kannst du das unter Einstellungen › Privatsphäre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu es invisible : tu vois les autres, mais personne ne te voit. Modifiable dans Réglages › Confidentialité."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres invisible: ves a los demás, pero nadie te ve. Puedes cambiarlo en Ajustes › Privacidad."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás invisível: vês os outros, mas ninguém te vê. Podes mudar em Definições › Privacidade."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent onzichtbaar: je ziet anderen, maar niemand ziet jou. Wijzig dit in Instellingen › Privacy."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś niewidoczny: widzisz innych, ale nikt nie widzi ciebie. Zmienisz to w Ustawienia › Prywatność."
          }
