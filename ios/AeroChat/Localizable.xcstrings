    "Non condividere numero di telefono, posto, documenti o dettagli di altri passeggeri." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Del ikke telefonnummer, sædenummer, dokumenter eller oplysninger om andre passagerer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Teile keine Telefonnummern, Sitzplätze, Dokumente oder Angaben zu anderen Passagieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Don’t share phone numbers, seat numbers, documents, or other passengers’ details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No compartas números de teléfono, asientos, documentos ni datos de otros pasajeros."
          }
        },
        "fr" : {
          "stringUnit" : {
