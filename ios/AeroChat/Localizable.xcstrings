    "Niente insulti, molestie, odio o discriminazioni. Le parolacce vengono oscurate." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ingen fornærmelser, chikane, had eller diskrimination. Bandeord bliver sløret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Keine Beleidigungen, Belästigungen, Hass oder Diskriminierung. Schimpfwörter werden ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "No insults, harassment, hate, or discrimination. Swear words are censored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nada de insultos, acoso, odio ni discriminación. Las palabrotas se ocultan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Pas d’insultes, de harcèlement, de haine ni de discrimination. Les gros mots sont masqués."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ingen fornærmelser, trakassering, hat eller diskriminering. Banneord sensureres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Geen beledigingen, intimidatie, haat of discriminatie. Scheldwoorden worden onleesbaar gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Żadnych obelg, nękania, nienawiści ani dyskryminacji. Wulgaryzmy są cenzurowane."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sem insultos, assédio, ódio ou discriminação. Os palavrões são ocultados."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
