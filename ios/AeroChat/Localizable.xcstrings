    "Scambia il posto, dividi un taxi all'arrivo, commenta il ritardo. Anonimo, solo nickname, sparisce dopo 12 ore." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Byt plads, del en taxa ved ankomsten, brok dig over forsinkelsen. Anonymt, kun kaldenavn, forsvinder efter 12 timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tausch den Sitzplatz, teil dir bei der Ankunft ein Taxi, lästere über die Verspätung. Anonym, nur Nickname, verschwindet nach 12 Stunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Swap seats, share a taxi on arrival, complain about the delay. Anonymous, nickname only, gone after 12 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Intercambia el asiento, comparte un taxi al llegar, comenta el retraso. Anónimo, solo un apodo, desaparece al cabo de 12 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Échange ta place, partage un taxi à l’arrivée, commente le retard. Anonyme, juste un pseudo, disparaît au bout de 12 heures."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bytt sete, del en taxi ved ankomst, klag på forsinkelsen. Anonymt, bare kallenavn, forsvinner etter 12 timer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ruil van stoel, deel een taxi bij aankomst, klaag over de vertraging. Anoniem, alleen een nickname, verdwijnt na 12 uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zamień się miejscem, podziel się taksówką po przylocie, skomentuj opóźnienie. Anonimowo, tylko nick, znika po 12 godzinach."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Troca de lugar, divide um táxi à chegada, comenta o atraso. Anónimo, só nickname, desaparece ao fim de 12 horas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Byt plats, dela taxi vid ankomsten, gnäll över förseningen. Anonymt, bara smeknamn, försvinner efter 12 timmar."
          }
        }
      }
    },
