    "Consenti il Bluetooth ad AeroChat in Impostazioni › Privacy per parlare con i compagni di volo." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tillad Bluetooth for AeroChat under Indstillinger › Anonymitet og sikkerhed for at snakke med dine rejsemakkere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Erlaube AeroChat in Einstellungen › Datenschutz den Bluetooth-Zugriff, um mit deinen Reisebuddys zu chatten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Allow Bluetooth for AeroChat in Settings › Privacy to talk to your travel buddies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite el Bluetooth a AeroChat en Ajustes › Privacidad para hablar con tus compañeros de viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Autorise le Bluetooth pour AeroChat dans Réglages › Confidentialité pour discuter avec tes compagnons de voyage."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tillat Bluetooth for AeroChat i Innstillinger › Personvern for å snakke med reisekameratene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sta Bluetooth toe voor AeroChat in Instellingen › Privacy om met je reisgenoten te praten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zezwól aplikacji AeroChat na dostęp do Bluetooth w Ustawienia › Prywatność, aby rozmawiać z towarzyszami podróży."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Permite que a AeroChat use o Bluetooth em Definições › Privacidade para falares com os teus companheiros de viagem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tillåt Bluetooth för AeroChat i Inställningar › Integritet för att prata med dina resekompisar."
