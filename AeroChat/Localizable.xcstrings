    "Sei connesso tramite un ponte: le foto richiedono una connessione diretta. Testo e mini-vocali restano attivi." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du er forbundet via et relæ: Fotos kræver en direkte forbindelse. Tekst og korte talebeskeder virker stadig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du bist über ein Relay verbunden: Fotos brauchen eine direkte Verbindung. Text und Mini-Sprachnachrichten funktionieren weiterhin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "You’re connected through a relay: photos need a direct connection. Text and mini voice notes still work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu conexión pasa por un puente: las fotos necesitan una conexión directa. El texto y las mininotas de voz siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu passes par un relais : les photos nécessitent une connexion directe. Le texte et les mini-notes vocales restent disponibles."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du er koblet til via et relé: bilder krever en direkte forbindelse. Tekst og korte talemeldinger fungerer fortsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je bent verbonden via een relais: foto’s hebben een directe verbinding nodig. Tekst en korte spraakberichten blijven werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Masz połączenie przez przekaźnik: zdjęcia wymagają połączenia bezpośredniego. Tekst i mini-wiadomości głosowe nadal działają."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Estás a comunicar através de uma ponte: as fotos exigem uma ligação direta. O texto e as mini-notas de voz continuam ativos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du är ansluten via ett relä: foton kräver en direkt anslutning. Text och korta röstmeddelanden fungerar fortfarande."
          }
        }
      }
    },
