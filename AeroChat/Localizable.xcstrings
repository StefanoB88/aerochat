    "Puoi riattivare il Bluetooth in totale sicurezza (come per le cuffie wireless) mantenendo spento il segnale cellulare." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kan trygt slå Bluetooth til igen (ligesom til trådløse hovedtelefoner) og lade mobilsignalet være slukket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kannst Bluetooth bedenkenlos wieder einschalten (wie für kabellose Kopfhörer) und den Mobilfunk dabei ausgeschaltet lassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "You can safely turn Bluetooth back on (just like for wireless headphones) while keeping cellular turned off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Puedes volver a activar el Bluetooth con total seguridad (como con los auriculares inalámbricos) manteniendo apagada la señal móvil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tu peux réactiver le Bluetooth en toute sécurité (comme pour des écouteurs sans fil) tout en laissant le réseau cellulaire désactivé."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kan trygt slå på Bluetooth igjen (akkurat som for trådløse hodetelefoner) og la mobilnettet være avslått."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Je kunt Bluetooth veilig weer inschakelen (net als voor draadloze koptelefoons) terwijl het mobiele netwerk uit blijft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Możesz bezpiecznie włączyć Bluetooth z powrotem (tak jak do słuchawek bezprzewodowych), zostawiając sieć komórkową wyłączoną."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Podes voltar a ligar o Bluetooth em total segurança (como para os auscultadores sem fios) mantendo a rede móvel desligada."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Du kan tryggt slå på Bluetooth igen (precis som för trådlösa hörlurar) och samtidigt låta mobilnätet vara avstängt."
          }
        }
      }
    },
